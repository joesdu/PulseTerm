<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001:面板视图刻意只有带上下文的构造(由 ShowPanelAsync 的工厂创建),
         不走运行时 XAML 装载器的无参构造路径。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件工程只需要这一个包:契约程序集、与宿主版本一致的 Avalonia(含 AXAML 编译器)、
         plugin.json 处理、清单校验与 `dotnet build -t:PackVpx` 都随它到位。 -->
    <PackageReference Include="VelaShell.PluginSdk.Build" Version="SDK_VERSION" />
  </ItemGroup>

</Project>

{
  // 插件 id:<发布者>.<名称>,小写 [a-z0-9.-]。它同时是命令 id 的前缀、
  // 插件私有数据与机密的命名空间 —— 发布之后不要再改,改了等于让老用户的配置失联。
  "id": "PLUGIN_ID",
  "version": "0.1.0",
  "displayName": "VelaPlugin1",
  "description": "A VelaShell plugin with an Avalonia panel.",
  "author": "AUTHOR_NAME",
  "publisher": "PUBLISHER_ID",
  "entry": "VelaPlugin1.dll",
  "apiLevel": 1,
  // inProcess:面板可停靠进主窗口标签区。isolated:面板是独立卡片窗口。
  "hostMode": "HOST_MODE",
  // 惰性激活:用户触发这条命令时才装载本插件的程序集。
  "activationEvents": [ "onCommand:PLUGIN_ID.open-panel" ],
  "contributes": {
    "commands": [
      {
        "id": "PLUGIN_ID.open-panel",
        "title": "VelaPlugin1: Open panel",
        "category": "VelaPlugin1"
      }
    ]
  }
}

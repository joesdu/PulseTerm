<Project>

  <!--
    VelaShell 插件工程的默认设定。本文件由 NuGet 在工程正文**之前**导入,
    因此这里的每一项都可以被插件工程自己覆盖。
  -->

  <PropertyGroup>
    <!-- 插件是被动态装载的组件:生成 deps.json(ALC 依赖解析的依据)、把自带依赖复制到
         输出目录、不复制共享框架。没有它,插件的第三方依赖在运行时一个都找不到。 -->
    <EnableDynamicLoading Condition="'$(EnableDynamicLoading)' == ''">true</EnableDynamicLoading>

    <!-- VelaShell 与其 SDK 都构建在预览版 .NET 上,契约程序集因此带 RequiresPreviewFeatures 标记。
         插件工程不跟着开这个开关的话,凡是碰到 IVelaPlugin / IPluginContext 的每一行都会报 CA2252 ——
         而那是宿主的既定事实,不是插件作者该逐个抑制的东西。 -->
    <EnablePreviewFeatures Condition="'$(EnablePreviewFeatures)' == ''">true</EnablePreviewFeatures>

    <!-- 清单路径。默认是工程根目录的 plugin.json。 -->
    <VelaPluginManifest Condition="'$(VelaPluginManifest)' == ''">$(MSBuildProjectDirectory)\plugin.json</VelaPluginManifest>

    <!-- 宿主的 Avalonia 版本。本包以精确区间锁死它;这里再留一份供 targets 核对
         (作者若直接引用了别的版本,NuGet 只给 NU1608 警告,下面把它升成错误)。 -->
    <VelaAvaloniaVersion Condition="'$(VelaAvaloniaVersion)' == ''">12.1.1</VelaAvaloniaVersion>

    <!-- 版本冲突不许只是警告:插件与宿主的 Avalonia 版本不一致会在用户机器上才炸,
         而那时的现象(控件类型转换失败)离根因非常远。 -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1608;NU1605</WarningsAsErrors>

    <!-- 构建后是否校验 plugin.json(清单改动时才跑,增量的)。 -->
    <VelaValidateManifestOnBuild Condition="'$(VelaValidateManifestOnBuild)' == ''">true</VelaValidateManifestOnBuild>

    <!-- 打包(-t:PackVpx)时是否对载荷做掩码变换。 -->
    <VelaPackMask Condition="'$(VelaPackMask)' == ''">true</VelaPackMask>
  </PropertyGroup>

  <ItemGroup>
    <!-- 清单随构建进输出目录:宿主的插件发现只认目录里的 plugin.json。 -->
    <None Include="$(VelaPluginManifest)" CopyToOutputDirectory="PreserveNewest" Link="plugin.json"
          Condition="Exists('$(VelaPluginManifest)')" />
  </ItemGroup>

</Project>

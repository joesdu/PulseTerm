<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VelaShell.PluginSdk.Build</PackageId>
    <Description>VelaShell 插件工程的构建支持包:一次引用即得到契约程序集、与宿主版本一致的 Avalonia、共享程序集不落地的处理、清单编译期校验,以及 `dotnet build -t:PackVpx` 一步出 .vpx 包。插件工程只需引用本包。</Description>
    <PackageTags>velashell;plugin;msbuild;vpx;sdk</PackageTags>
    <Version>$(VelaSdkVersion)</Version>

    <!-- 本包不含任何程序集,只有 MSBuild 逻辑与 tools/ 下的打包器。 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NU5128:有依赖但无 lib/ 目录。对纯 MSBuild 包是正常形态。 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddVelaCliToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件作者引用本包即得到这两项,且都以 exclude="Runtime" 的形式传递 ——
         编译期可见,运行时不复制。原因见 PluginAssemblyLoadContext:
         VelaShell.PluginSdk 与 Avalonia* 必须与装载方是同一份程序集。 -->
    <!-- PrivateAssets="none" 不能省:NuGet 默认不让 build/analyzers 资产传递给下游,
         而 Avalonia 的 **AXAML 编译器就在它的 build 资产里** —— 少了这一条,
         插件工程里的 .axaml 根本不会被编译,现象是运行时找不到控件而不是构建报错。 -->
    <PackageReference Include="Avalonia" Version="[$(VelaAvaloniaVersion)]" ExcludeAssets="runtime" PrivateAssets="none" />
    <ProjectReference Include="..\VelaShell.PluginSdk\VelaShell.PluginSdk.csproj" ExcludeAssets="runtime" PrivateAssets="none" />
    <!-- 打包器(vela-plugin)随本包分发到 tools/:插件工程无需安装任何全局工具即可出包。
         只借它的构建顺序与产物,不产生包依赖、不引用其程序集。 -->
    <ProjectReference Include="..\..\tools\VelaShell.Plugin.Cli\VelaShell.Plugin.Cli.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!--
    Avalonia 版本锁的一致性核对。本包对外用精确版本区间 [x.y.z] 锁死 Avalonia,那个版本必须
    等于宿主实际引用的版本 —— 否则插件编译期拿到的 Avalonia 与运行期被强制共享的宿主 Avalonia
    是两个版本,表现为跨 ALC 的控件类型对不上,而且要等到用户装上插件才炸。
    这里在构建期就把两处比一遍,漂了直接红。
  -->
  <Target Name="VerifyAvaloniaVersionPin" BeforeTargets="Build">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\..\src\Directory.Packages.props"
             Query="/Project/ItemGroup/PackageVersion[@Include='Avalonia']/@Version">
      <Output TaskParameter="Result" ItemName="_VelaHostAvaloniaVersion" />
    </XmlPeek>
    <Error Condition="'@(_VelaHostAvaloniaVersion)' != '$(VelaAvaloniaVersion)'"
           Code="VELA1000"
           Text="Avalonia version pin drifted: VelaAvaloniaVersion in Directory.Build.props is '$(VelaAvaloniaVersion)' but the host references '@(_VelaHostAvaloniaVersion)' (src/Directory.Packages.props). Plugin packages built from this SDK would compile against a different Avalonia than the host loads. Update both to the same version." />
  </Target>

  <!-- 把 vela-plugin 的构建产物收进包的 tools/net11.0/(dotnet exec 需要 dll + runtimeconfig + deps)。 -->
  <Target Name="AddVelaCliToPackage">
    <PropertyGroup>
      <_VelaCliOutputDir>$(MSBuildThisFileDirectory)..\..\tools\VelaShell.Plugin.Cli\bin\$(Configuration)\$(TargetFramework)\</_VelaCliOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_VelaCliFile Include="$(_VelaCliOutputDir)*.dll;$(_VelaCliOutputDir)*.json" />
      <TfmSpecificPackageFile Include="@(_VelaCliFile)" PackagePath="tools/$(TargetFramework)/%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="'@(_VelaCliFile)' == ''"
           Code="VELA1002"
           Text="vela-plugin build output not found at $(_VelaCliOutputDir); build tools/VelaShell.Plugin.Cli first." />
  </Target>

</Project>

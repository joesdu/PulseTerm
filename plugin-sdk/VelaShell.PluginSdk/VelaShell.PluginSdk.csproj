<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>VelaShell 插件开发 SDK:插件入口契约、能力接口(会话/远程文件/远程执行/命令/存储/日志/事件)与 plugin.json 清单模型。</Description>
    <RootNamespace>VelaShell.PluginSdk</RootNamespace>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>VelaShell Redis 插件:Redis / Valkey 的完整界面客户端 —— 键空间浏览器 + 类型编辑器 + 命令控制台 + 服务器概览。</Description>
    <!-- 与 plugin.json 的 id 一致;驱动构建后复制到应用输出的 plugins/<目录名>/
         (目录名 = id 把点换成短横,原因见 plugins/Directory.Build.targets)。 -->
    <VelaPluginId>velashell.redis</VelaPluginId>
    <!-- AVLN3001:面板视图刻意只有带上下文的构造(由文档工厂创建),
         不需要运行时 XAML 装载器的无参构造路径。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 由宿主统一提供(共享契约程序集),不随插件输出复制。 -->
    <ProjectReference Include="..\..\plugin-sdk\VelaShell.PluginSdk\VelaShell.PluginSdk.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- 仅编译期引用 Avalonia,运行时由装载方共享同一套(版本须与宿主一致)。 -->
    <PackageReference Include="Avalonia" Version="12.1.1" ExcludeAssets="runtime" />
    <!-- Redis 客户端(MIT,与本仓库 AGPL-3.0 + 商业双许可相容)。**随插件目录分发**,
         由插件 ALC 按 deps.json 隔离解析 —— 不用 Redis 的用户,安装包里不必带它。
         已知边界(见 docs/Redis客户端插件化调研与设计.md §四):多路复用连接不提供
         MONITOR 与阻塞类命令(BLPOP 等);控制台上这两类命令按"该连接形态不支持"如实拒绝,
         不假装能跑。 -->
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单测直接驱动内部实现(设置解析、扫描器、键树)。 -->
    <InternalsVisibleTo Include="VelaShell.Plugin.Redis.Tests" />
  </ItemGroup>

</Project>

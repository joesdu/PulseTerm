<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VelaShell.Plugin.Ai.Ui.PluginDialog"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource VelaBgSurface}"
        MinWidth="520" MinHeight="360">

  <!-- 插件自己的对话框外壳:标题栏用系统的(自绘窗体是宿主的事,插件不该也无法复用),
       内容区配色全走 Vela 令牌,于是明暗主题跟着宿主走。 -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelaShell.Plugin.Ai/Ui/AiTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.dialogTitle">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 弱化文字与聊天面板同一套(理由见 ChatPanelView.axaml:Muted 对比度太低) -->
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector="TextBlock.toolName">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- "配置工具"里每个来源一块(内置 / 各 MCP 服务器) -->
    <Style Selector="Border.toolGroup">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">
    <Grid x:Name="TitleRow" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" Classes="dialogTitle" />
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" />
    </Grid>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource VelaBorderPrimary}"
            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CloseButton" Theme="{DynamicResource VelaAccentPillButtonTheme}"
                Height="28" Padding="18,0" />
      </StackPanel>
    </Border>
    <ContentControl x:Name="Body" />
  </DockPanel>
</Window>

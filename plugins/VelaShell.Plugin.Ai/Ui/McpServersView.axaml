<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:VelaShell.Plugin.Ai.Ui"
             x:Class="VelaShell.Plugin.Ai.Ui.McpServersView">

  <!-- MCP 服务器的增删改查,自己占一个窗口(入口是「配置工具」标题行右侧的 ⚙)。
       版式:左边一列服务器,右边一张表单卡片,两边都吃满窗口高度 —— 这一页字段不少,
       用 StackPanel 会让列表缩成一小块、下面空一大片。 -->

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelaShell.Plugin.Ai/Ui/AiTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://VelaShell.Plugin.Ai/Ui/DialogStyles.axaml" />
  </UserControl.Styles>

  <!-- 内边距 20/16:内容直接贴着窗口边框很难看(这是补上的) -->
  <DockPanel Margin="20,16,20,16">
    <!-- 一句话说清 MCP 是什么、以及"非只读工具要过审批" —— 头一次开这个窗口的人需要它 -->
    <TextBlock x:Name="McpHintText" DockPanel.Dock="Top" Classes="dim"
               TextWrapping="Wrap" Margin="0,0,0,12" />
  <Grid ColumnDefinitions="230,14,*">
    <!-- 左:服务器列表 + 新增 -->
    <DockPanel Grid.Column="0">
      <Button x:Name="McpAddButton" DockPanel.Dock="Bottom" Theme="{DynamicResource VelaOutlineButtonTheme}"
              HorizontalAlignment="Stretch" Height="28" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Viewbox Width="11" Height="11" VerticalAlignment="Center">
            <Path Width="24" Height="24" Data="{DynamicResource Icon.plus}"
                  Stroke="{DynamicResource VelaTextSecondary}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Viewbox>
          <TextBlock x:Name="McpAddText" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Panel>
        <ListBox x:Name="McpList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ui:McpListItem">
              <!-- 两行:名字 + 一行说明(传输方式 · 工具数,停用的另标)——
                   光一个名字看不出这台连的是什么、拉没拉过工具 -->
              <StackPanel Spacing="1" Margin="2,3">
                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                           FontSize="{DynamicResource VelaFontSize12}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="dim" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- 一台都没有时,列表里空着不如直接说下一步该点哪儿 -->
        <TextBlock x:Name="McpEmptyText" Classes="dim" IsVisible="False" TextWrapping="Wrap"
                   TextAlignment="Center" VerticalAlignment="Center" Margin="16" />
      </Panel>
    </DockPanel>

    <!-- 右:选中那台的表单;没选中就只留一句提示,不摆一堆灰着的空框 -->
    <Panel Grid.Column="2">
      <TextBlock x:Name="McpNoSelectionText" Classes="dim" IsVisible="False" TextWrapping="Wrap"
                 TextAlignment="Center" VerticalAlignment="Center" />

      <Border x:Name="McpForm" Classes="card">
        <DockPanel>
          <!-- 卡片头:名字 + 启用开关。启用与否是这台服务器最要紧的一个状态,放最上面 -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
            <TextBlock x:Name="McpTitleText" FontWeight="SemiBold"
                       FontSize="{DynamicResource VelaFontSize13}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <CheckBox x:Name="McpEnabledCheck" Grid.Column="1" Theme="{StaticResource AiCheckBoxTheme}"
                      FontSize="{DynamicResource VelaFontSize12}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock x:Name="McpToolsText" DockPanel.Dock="Top" Classes="dim"
                     TextWrapping="Wrap" Margin="0,0,0,4" />

          <!-- 底部操作行:保存/测试在左,删除推到右边 —— 破坏性操作别挨着主操作 -->
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource VelaBorderPrimary}"
                  BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="McpSaveButton" Theme="{DynamicResource VelaAccentPillButtonTheme}" Height="26" Padding="12,0">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                      <Path Width="24" Height="24" Data="{DynamicResource Icon.save}"
                            Stroke="{DynamicResource VelaAccent}" StrokeThickness="2"
                            StrokeLineCap="Round" StrokeJoin="Round" />
                    </Viewbox>
                    <TextBlock x:Name="McpSaveText" VerticalAlignment="Center"
                               FontSize="{DynamicResource VelaFontSize11}" FontWeight="Medium" />
                  </StackPanel>
                </Button>
                <!-- 「测试」顺带把工具库拉下来 —— 连都连上了,再让人去别处点一次"更新工具库"是多余的 -->
                <Button x:Name="McpTestButton" Theme="{DynamicResource VelaOutlineButtonTheme}" Height="26" Padding="12,0">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                      <Path Width="24" Height="24" Data="{DynamicResource Icon.play}"
                            Stroke="{DynamicResource VelaTextSecondary}" StrokeThickness="2"
                            StrokeLineCap="Round" StrokeJoin="Round" />
                    </Viewbox>
                    <TextBlock x:Name="McpTestText" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <Button x:Name="McpDeleteButton" Grid.Column="2" Theme="{DynamicResource VelaOutlineButtonTheme}"
                      Height="26" Padding="12,0"
                      Foreground="{DynamicResource VelaError}" BorderBrush="{DynamicResource VelaError}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                    <Path Width="24" Height="24" Data="{DynamicResource Icon.trash-2}"
                          Stroke="{DynamicResource VelaError}" StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                  </Viewbox>
                  <TextBlock x:Name="McpDeleteText" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <TextBlock x:Name="McpStatusText" DockPanel.Dock="Bottom" Classes="dim"
                     TextWrapping="Wrap" Margin="0,10,0,0" />

          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- 右缘留白让给覆盖式滚动条,免得它压住输入框 -->
            <StackPanel Margin="0,0,14,0">
              <TextBlock x:Name="McpNameLabel" Classes="label" />
              <TextBox x:Name="McpNameBox" />
              <TextBlock x:Name="McpTransportLabel" Classes="label" />
              <ComboBox x:Name="McpTransportCombo" HorizontalAlignment="Stretch" />

              <StackPanel x:Name="McpStdioPanel">
                <TextBlock x:Name="McpCommandLabel" Classes="label" />
                <TextBox x:Name="McpCommandBox" FontFamily="{DynamicResource VelaUiMonoFont}" />
                <TextBlock x:Name="McpArgumentsLabel" Classes="label" />
                <TextBox x:Name="McpArgumentsBox" FontFamily="{DynamicResource VelaUiMonoFont}" />
                <TextBlock x:Name="McpStdioHintText" Classes="hint" />
                <TextBlock x:Name="McpWorkingDirLabel" Classes="label" />
                <TextBox x:Name="McpWorkingDirBox" FontFamily="{DynamicResource VelaUiMonoFont}" />
                <TextBlock x:Name="McpWorkingDirHintText" Classes="hint" />
                <TextBlock x:Name="McpEnvLabel" Classes="label" />
                <TextBox x:Name="McpEnvBox" AcceptsReturn="True" MinHeight="52" TextWrapping="NoWrap"
                         FontFamily="{DynamicResource VelaUiMonoFont}" />
              </StackPanel>

              <StackPanel x:Name="McpHttpPanel" IsVisible="False">
                <TextBlock x:Name="McpUrlLabel" Classes="label" />
                <TextBox x:Name="McpUrlBox" FontFamily="{DynamicResource VelaUiMonoFont}" />
                <TextBlock x:Name="McpHttpHintText" Classes="hint" />
                <TextBlock x:Name="McpHeadersLabel" Classes="label" />
                <TextBox x:Name="McpHeadersBox" AcceptsReturn="True" MinHeight="52" TextWrapping="NoWrap"
                         FontFamily="{DynamicResource VelaUiMonoFont}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
  </DockPanel>
</UserControl>

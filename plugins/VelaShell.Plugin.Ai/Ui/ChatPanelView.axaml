<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:aee="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:mdm="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia.Mermaid"
             xmlns:ui="clr-namespace:VelaShell.Plugin.Ai.Ui"
             x:Class="VelaShell.Plugin.Ai.Ui.ChatPanelView">

  <!-- 视觉语言对齐宿主(DESIGN.md §5.1):主操作 = VelaAccentPillButtonTheme 强调药丸,
       次操作 = VelaOutlineButtonTheme 描边;输入区仿宿主 input-affix 容器
       (外层 Border 承担边框/焦点态,内部 TextBox 去壳);图标用宿主 Icon.* 几何
       (lucide 24 视图框,Viewbox 等比缩放描边渲染)。配色/字体/字号全走 Vela* 令牌。 -->

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VelaShell.Plugin.Ai/Ui/AiTheme.axaml" />
        <!-- LiveMarkdown 的默认令牌:字号(FontSizeS…3Xl,代码块头部按钮的宽高也取这里)必须有,
             否则模板里的 {DynamicResource FontSize2Xl} 解析不到、按钮塌成 0。颜色键随后由
             SyncMarkdownSkin() 用 Vela* 令牌就地覆盖(直接键优先于 MergedDictionaries)。 -->
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- LiveMarkdown 自带样式必须先并进来,后面的皮肤覆盖才压得住(Avalonia 同优先级按声明顺序,后者胜)。 -->
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://LiveMarkdown.Avalonia.Mermaid/Styles.axaml" />
    <!-- 输入框(AvaloniaEdit)的控件模板:宿主 App.axaml 里也并了一份,但插件不能假定
         装载方一定并过 —— 自己带上,面板在哪儿都能正常成型。 -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- 弱化文字统一用 VelaTextTertiary 而不是 VelaTextMuted:Muted(#545B76)压在
         面板底色上对比度太低,这些是"要读的信息"(思考区标题、时刻、模型、用量),
         不是纯装饰,不该淡到看不清。 -->
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    </Style>
    <Style Selector="TextBlock.roleHeader">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- 输入框的占位提示:字号贴近正文(13),免得比要输入的内容小一大截 -->
    <Style Selector="TextBlock.placeholder">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextTertiary}" />
    </Style>

    <!-- 消息上的编辑/删除:平时隐形,鼠标移到这条消息上才浮出来 -->
    <Style Selector="StackPanel.msgActions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.msg:pointerover StackPanel.msgActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- 上下文压缩的分隔条:从这里往上,模型看到的是摘要而不是原文,得让人看得见 -->
    <Style Selector="Border.compactionMarker">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,6" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- "显示更早的 N 条":早期消息被移出可视树后留下的入口 -->
    <Style Selector="Border.earlierBanner">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.earlierBanner:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>

    <!-- 输入框上方的建议药丸(同 Copilot 的后续提问):整枚可点,悬停换强调描边 -->
    <Style Selector="Border.suggestChip">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.suggestChip:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>
    <Style Selector="Border.suggestChip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="Border.suggestChip:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    </Style>
    <Style Selector="SelectableTextBlock.body">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize13}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineSpacing" Value="4" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- assistant 卡片:表面色 + 主描边;user 卡片:半透明强调底(与药丸同配方),无描边感 -->
    <Style Selector="Border.msg">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.userMsg">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.toolCard">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- 历史会话行:整行可点(悬停高亮),右侧删除按钮悬停才显形 -->
    <Style Selector="Border.historyRow">
      <Setter Property="Background" Value="{DynamicResource VelaBgSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.historyRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>
    <Style Selector="Border.historyRow.current">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
    </Style>
    <Style Selector="TextBlock.historyTitle">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- @ 文件选择:候选行,选中项用强调底(键盘上下键驱动,不靠 ListBox) -->
    <Style Selector="Border.fileRow">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.fileRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Border.fileRow.selected">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
    </Style>
    <Style Selector="TextBlock.fileName">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 输入容器:仿宿主 Border.input-affix(悬停换次描边、聚焦换强调描边)。
         高度取自内部编辑器的 MinHeight —— 与 Copilot 一致,输入区默认就有几行的余量,
         写多行提示词不必先撑开。 -->
    <Style Selector="Border.inputWrap">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.inputWrap:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
    </Style>
    <Style Selector="Border.inputWrap:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>
    <!-- 输入框是 AvaloniaEdit(要的是 Markdown 高亮与 @ 引用芯片这类内联富文本,
         纯 TextBox 给不了)。外层 Border.inputWrap 继续承担边框/焦点态,编辑器本身去壳:
         透明底、无边框,内边距给在编辑器上(它的模板会把 Padding 传给内部滚动区)。 -->
    <Style Selector="Border.inputWrap ae|TextEditor">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize13}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
    </Style>
    <Style Selector="Border.inputWrap ae|TextEditor /template/ Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- 用户气泡里的文件引用芯片(输入框内那段引用是编辑器自己上色的,见 InputEditor.cs;
         两处取同一对令牌,观感一致)。 -->
    <Style Selector="Border.refChip">
      <Setter Property="Background" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.refChipText">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>

    <!-- 选区随主题令牌(编辑器默认是硬编码的黑白)。 -->
    <Style Selector="Border.inputWrap aee|TextArea">
      <Setter Property="SelectionBrush" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="SelectionForeground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="SelectionCornerRadius" Value="2" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===== LiveMarkdown 皮肤 =====
         库自带样式是"深色硬编码 + 文档级字号"(正文 14、H1 24),这里整体压到 Vela 令牌
         与聊天面板的紧凑节奏,主题切换随 DynamicResource 自动跟随。
         只有代码块头/体的底色藏在 CodeBlock 的 ControlTemplate 里、选择器够不到,
         那几个键改由 code-behind 的 SyncMarkdownSkin() 写进本控件资源。 -->
    <Style Selector="md|MarkdownRenderer md|MarkdownTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize13}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="LineSpacing" Value="4" />
      <Setter Property="SelectionBrush" Value="{DynamicResource VelaAccentDim}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource VelaTextPrimary}" />
    </Style>

    <Style Selector="md|MarkdownRenderer Border.Heading1Block md|MarkdownTextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize16}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="md|MarkdownRenderer Border.Heading2Block md|MarkdownTextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize15}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="md|MarkdownRenderer Border.Heading3Block md|MarkdownTextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="md|MarkdownRenderer Border.Heading4Block md|MarkdownTextBlock,
                     md|MarkdownRenderer Border.Heading5Block md|MarkdownTextBlock,
                     md|MarkdownRenderer Border.Heading6Block md|MarkdownTextBlock">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize13}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="md|MarkdownRenderer md|Link, md|MarkdownRenderer md|Link:clicked">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
    </Style>

    <Style Selector="md|MarkdownRenderer md|CodeInline">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- 代码块:字体/字号靠 CodeBlock 继承进模板(模板对 FontFamily 有 TemplateBinding,
         FontSize 走文本继承);模板内的按钮尺寸压到 18,免得 20px 方块把标题行撑高。 -->
    <Style Selector="md|CodeBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
    <!-- 标题栏底色:模板里两个 Border 都没 x:Name(第一个标题栏、第二个正文),只能按位置取。
         不走 BorderColor 键是因为那个键被 Mermaid 拿去画线条了(见 SyncMarkdownSkin)。
         万一库改了模板结构,这条不匹配也只是标题栏退回描边色,不会崩。 -->
    <Style Selector="md|CodeBlock /template/ Border:nth-child(1)">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="md|CodeBlock /template/ TextBlock#PART_LanguageTextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    </Style>
    <Style Selector="md|CodeBlock /template/ Button#PART_CopyButton,
                     md|CodeBlock /template/ ToggleButton#PART_ToggleTextWrapButton">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 模板里的提示文案是写死的英文;走资源键由 ApplyLoc 灌入,语言实时切换才跟得上 -->
    <Style Selector="md|CodeBlock /template/ Button#PART_CopyButton">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource AiCopyTip}" />
    </Style>
    <Style Selector="md|CodeBlock /template/ ToggleButton#PART_ToggleTextWrapButton">
      <Setter Property="ToolTip.Tip" Value="{DynamicResource AiWrapTip}" />
    </Style>

    <Style Selector="md|MarkdownRenderer Border.QuoteBlock">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="md|MarkdownRenderer Border.Table">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="md|MarkdownRenderer Border.TableCell">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
    </Style>

    <Style Selector="md|MarkdownRenderer Border.ThematicBreak">
      <Setter Property="Background" Value="{DynamicResource VelaBorderPrimary}" />
    </Style>

    <!-- Mermaid:配色全部走 ForegroundColor/BorderColor/CardBackgroundColor 三个键,
         已由 SyncMarkdownSkin 映射到 Vela 令牌,这里只把字号压到聊天面板的尺度。
         图容器默认 MaxHeight 600,在侧栏里太占版面;FitToViewport 会自动缩放。 -->
    <Style Selector="mdm|MermaidPresenter">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="NodeLabelFontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="EdgeLabelFontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="GroupHeaderFontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="MemberFontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="AnnotationFontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="KeyBadgeFontSize" Value="{DynamicResource VelaFontSize10}" />
    </Style>
    <Style Selector="mdm|PanAndZoom.MermaidBlock">
      <Setter Property="MaxHeight" Value="420" />
    </Style>
    <!-- LaTeX 的配色不在这里:CSharpMath 的 MathView 吃不到类型选择器(基类是泛型,
         StyleKey 对不上,实测字面色样式也不生效),只能在 ApplyMathColors() 里就地设。 -->

    <!-- 图还没画完(流式中)或语法错时退回文本显示,用等宽区分 -->
    <Style Selector="md|MarkdownRenderer md|MarkdownTextBlock.MermaidBlock,
                     md|MarkdownRenderer md|MarkdownTextBlock.MathBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
    </Style>
    <Style Selector="md|MarkdownRenderer md|MarkdownTextBlock.MermaidBlock.Error,
                     md|MarkdownRenderer md|MarkdownTextBlock.MathBlock.Error">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
    </Style>

    <Style Selector="md|MarkdownRenderer TextBlock.ListBlockNumber,
                     md|MarkdownRenderer TextBlock.ListBlockBullet">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
    </Style>

    <!-- 紧凑工具卡(主流 Agent 风格:单行头 + 点击展开详情) -->
    <Style Selector="TextBlock.toolName">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.toolArgs">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 回复气泡底部的元信息条(时间 · 模型)与复制按钮所在行:
         一条细分隔线把它与正文隔开,文字压到最小号且用弱化色 —— 只在需要时才被看见。 -->
    <Style Selector="Border.replyFooter">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Padding" Value="0,4,0,0" />
    </Style>
    <!-- 时刻 · 模型 / token 用量:是要看的数,给次级文字色 + 11 号,别糊在背景里 -->
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- 输入框下方的工具条:模型选择 / Agent 开关 / 用量。控件统一 24 高并垂直居中
         (同顶栏的理由:混用自然高度会错开中线,勾选随 Agent 显隐时还会撑高整行)。 -->
    <Style Selector="Grid#InputToolbar ComboBox">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
    </Style>
    <!-- 这一行的高度必须与内容无关:自动批准随 Agent 开关显隐,行一变高整个输入区就会跳。
         行高写死,勾选框也跟着写死同一高度(MinHeight 得压过主题里的 26)。 -->
    <Style Selector="Grid#InputStatusBar">
      <Setter Property="Height" Value="20" />
    </Style>
    <!-- 字号取 11(同 Agent 芯片):15px 的勾选方块配 10px 的字,方块显得比字高一截,
         视觉上就不在一条线上了 —— 那是字面高度与方块高度的差,不是没居中(居中有测试守着)。 -->
    <Style Selector="Grid#InputStatusBar CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#InputToolbar ToggleButton">
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 顶栏所有控件统一 26 高并显式垂直居中:混用自然高度(Fluent 下拉 30+、
         勾选 32)会导致不在同一中线,且勾选随 Agent 开关显隐时撑高整行造成跳动。 -->
    <Style Selector="Grid#TopBar ComboBox">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#TopBar CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#TopBar ToggleButton">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#TopBar Button">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="10">
    <!-- 顶栏:会话(SSH)| 历史 / 新会话 / 设置。
         模型选择与 Agent 开关不在这里 —— 它们跟着输入框走(见下方 InputToolbar),
         与 GitHub Copilot 一致:决定"这条消息怎么发"的东西,应当挨着输入框。 -->
    <Grid x:Name="TopBar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ComboBox x:Name="SessionCombo" MinWidth="110" MaxWidth="240" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ToggleButton x:Name="HistoryToggle" Theme="{StaticResource AiChipToggleTheme}" Width="30" Padding="0">
          <Viewbox Width="13" Height="13">
            <Path Width="24" Height="24" Data="{DynamicResource Icon.history}"
                  Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Viewbox>
        </ToggleButton>
        <Button x:Name="NewChatButton" Theme="{DynamicResource VelaOutlineButtonTheme}" Height="26" Padding="8,0">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Viewbox Width="11" Height="11" VerticalAlignment="Center">
              <Path Width="24" Height="24" Data="{DynamicResource Icon.plus}"
                    Stroke="{DynamicResource VelaTextSecondary}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Viewbox>
            <TextBlock x:Name="NewChatText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="SettingsToggle" Theme="{StaticResource AiChipToggleTheme}" Width="30" Padding="0">
          <Viewbox Width="13" Height="13">
            <Path Width="24" Height="24" Data="{DynamicResource Icon.settings}"
                  Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Viewbox>
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- 最下沿的一条细行(同 Copilot 输入框下方那排):左边是 Agent 的审批模式,
         右边是 token 用量。放在容器外而不是工具条里,是为了不跟模型下拉抢那点宽度。 -->
    <Grid x:Name="InputStatusBar" DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2,5,2,0">
      <CheckBox x:Name="AutoApproveCheck" Theme="{StaticResource AiCheckBoxTheme}" IsVisible="False" />
      <!-- 命中缓存时这段会长一截(多一个"缓存 80%"),留够宽度;再长由 TextTrimming 收,
           完整明细本来就在悬停提示里。 -->
      <TextBlock x:Name="UsageText" Grid.Column="1" Classes="meta" MaxWidth="320" Margin="8,0,0,0" />
    </Grid>

    <!-- 输入容器 = 编辑区 + 其下的工具条(模型选择 / Agent / 发送),状态行悬于其上。
         工具条与编辑区同处一个描边容器内,是 GitHub Copilot 的做法 —— 这些开关属于"这一条消息",
         视觉上就该被输入框圈进去,而不是散在顶栏。
         @ 文件选择弹层挂在输入容器上沿:焦点始终留在输入框(弹层不接管键盘),
         上下键与回车由 OnInputKeyDown 在隧道阶段代为处理。 -->
    <!-- 输入容器外再套一层 Panel:流光是<b>盖在</b>边框上画的一层覆盖物(不吃命中测试、
         不参与布局),底下那圈边框仍旧由样式管颜色。 -->
    <Panel DockPanel.Dock="Bottom" Margin="0,8,0,0">
    <Border x:Name="InputWrap" Classes="inputWrap">
      <!-- 两行都是 Auto:容器高度由编辑器的 MinHeight/MaxHeight 决定(内容多了自己长,
           到 220 封顶后编辑器内部滚动),工具条永远贴在下沿。 -->
      <Grid RowDefinitions="Auto,Auto">
        <Popup x:Name="FilePopup" Placement="TopEdgeAlignedLeft" VerticalOffset="-4"
               IsLightDismissEnabled="True" Focusable="False">
          <Border Background="{DynamicResource VelaBgSurface}"
                  BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1"
                  CornerRadius="4" Padding="4" MinWidth="320" MaxWidth="520">
            <StackPanel Spacing="2">
              <TextBlock x:Name="FilePopupHeader" Classes="dim" Margin="6,2" TextTrimming="CharacterEllipsis" />
              <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FileList" Spacing="1" />
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
        <!-- 编辑器没有占位提示,拿一个不吃命中测试的 TextBlock 叠上去,由代码后置随文本显隐。 -->
        <Panel>
          <ae:TextEditor x:Name="InputBox"
                         WordWrap="True"
                         MinHeight="66"
                         MaxHeight="220"
                         ShowLineNumbers="False"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto" />
          <TextBlock x:Name="InputPlaceholder" Classes="placeholder"
                     Margin="12,8" IsHitTestVisible="False"
                     VerticalAlignment="Top" TextWrapping="Wrap" />
        </Panel>

        <!-- 只放"发这一条要用什么":模型 / Agent / 发送。模型那列是 * —— 面板收窄时
             先挤模型名(下拉里仍看得全),而不是把发送按钮挤出边界。 -->
        <Grid x:Name="InputToolbar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="6,0,5,5">
          <Button x:Name="AttachButton" Theme="{StaticResource AiGhostIconButtonTheme}" Margin="0,0,4,0">
            <Viewbox Width="13" Height="13">
              <Path Width="24" Height="24" Data="{DynamicResource Icon.plus}"
                    Stroke="{DynamicResource VelaTextMuted}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Viewbox>
          </Button>
          <ComboBox x:Name="ProviderCombo" Grid.Column="1" MaxWidth="230" HorizontalAlignment="Left" />
          <ToggleButton x:Name="AgentToggle" Grid.Column="2" Theme="{StaticResource AiChipToggleTheme}"
                        Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                <Path Width="24" Height="24" Data="{DynamicResource Icon.zap}"
                      Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Viewbox>
              <TextBlock x:Name="AgentText" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button x:Name="SendButton" Theme="{DynamicResource VelaAccentPillButtonTheme}"
                    Height="24" Width="34" Padding="0">
              <Viewbox Width="12" Height="12">
                <Path Width="24" Height="24" Data="{DynamicResource Icon.send}"
                      Stroke="{DynamicResource VelaAccent}" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Viewbox>
            </Button>
            <Button x:Name="StopButton" Theme="{DynamicResource VelaOutlineButtonTheme}"
                    Height="24" Width="34" Padding="0" IsVisible="False"
                    Foreground="{DynamicResource VelaError}" BorderBrush="{DynamicResource VelaError}">
              <Viewbox Width="11" Height="11">
                <Path Width="24" Height="24" Data="{DynamicResource Icon.square}"
                      Stroke="{DynamicResource VelaError}" StrokeThickness="2"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
      <ui:BorderGlowOverlay x:Name="InputGlow" IsHitTestVisible="False" />
    </Panel>
    <!-- 建议药丸:紧贴输入框上沿(声明顺序 = 由下往上排,故排在 InputWrap 之后、状态行之前)。
         空会话给几条起手提示(不花钱),一轮答完再由模型给后续提问。 -->
    <!-- 待发的本地附件(拖进来或 + 选的),点芯片可移除 -->
    <WrapPanel x:Name="AttachmentBar" DockPanel.Dock="Bottom" IsVisible="False" Margin="2,6,2,0" />
    <WrapPanel x:Name="SuggestionBar" DockPanel.Dock="Bottom" IsVisible="False" Margin="2,6,2,0" />
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Classes="dim" Margin="2,6,2,0" TextWrapping="Wrap" />

    <!-- 中部:消息流 / 设置页(二选一显示)。
         滚动条留白放在内容的 Margin 上(同 ResourceMonitor 的做法,勿用 ScrollViewer.Padding):
         悬停展开的覆盖式滚动条约 12px 宽,留 19px 保证不压住消息卡片。 -->
    <Panel>
      <ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="MessagesPanel" Spacing="8" Margin="5,4,19,4" />
      </ScrollViewer>
      <ContentControl x:Name="SettingsHost" IsVisible="False" />
      <!-- 历史会话:与聊天流/设置页三选一显示 -->
      <DockPanel x:Name="HistoryHost" IsVisible="False" Margin="5,4,19,4">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock x:Name="HistoryHeader" Classes="dim" VerticalAlignment="Center" />
          <Button x:Name="ClearHistoryButton" Grid.Column="1" Theme="{DynamicResource VelaOutlineButtonTheme}"
                  Height="24" Padding="10,0" FontSize="{DynamicResource VelaFontSize11}" />
        </Grid>
        <!-- 按标题搜索(本地筛已取回的摘要,不重复查库) -->
        <TextBox x:Name="HistorySearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                 MinHeight="26" FontSize="{DynamicResource VelaFontSize12}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="HistoryList" Spacing="4" />
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>

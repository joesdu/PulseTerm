<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>VelaShell 隔离插件宿主进程:经命名管道 RPC 连接主程序,在可收集 ALC 中装载并运行单个插件。</Description>
    <!-- 只依赖 SDK 契约,严禁引用任何 VelaShell.* 主程序工程(设计稿 02 §2 依赖纪律)。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件契约程序集。默认取 nuget.org 上的正式包(版本 = 根 Directory.Build.props 的
         VelaSdkVersion);设了 VelaSdkPath 则换成对本机工具链仓库的 ProjectReference,
         便于改契约时联调,见根 Directory.Build.props 的说明。 -->
    <PackageReference Include="VelaShell.PluginSdk" Condition="'$(VelaSdkPath)' == ''" />
    <ProjectReference Include="$(VelaSdkProject)" Condition="'$(VelaSdkPath)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- 隔离插件的完整 UI:本进程内建 Avalonia(与宿主同版,由 CPM 钉住)。
         插件程序集的 Avalonia 引用经 ALC 回落到本进程这套,保证类型同一。 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VelaShell.ViewModels"
             xmlns:loc="using:VelaShell.Localization"
             x:Class="VelaShell.Views.Settings.ShortcutsPage"
             x:DataType="vm:SettingsViewModel">

  <!-- 快捷键参考页(只读):条目全部来自 ShortcutCatalog,与 docs/快捷键参考.md 同源。
       新增绑定只需改目录,本页与文档一起跟着变;这里不放任何写死的键位。 -->

  <StackPanel Spacing="14">
    <StackPanel Spacing="2">
      <TextBlock Classes="page-title" Text="{loc:Localize SetShortcuts_Title}" />
      <TextBlock Classes="page-subtitle" Text="{loc:Localize SetShortcuts_Subtitle}" />
    </StackPanel>

    <!-- 搜索:动作名、键位与生效条件一起匹配(ShortcutItem.SearchText)。 -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBox Text="{Binding ShortcutFilter}"
               PlaceholderText="{loc:Localize Sc_FilterPlaceholder}" />
      <TextBlock Grid.Column="1" Classes="row-desc"
                 Text="{Binding ShortcutCountText}"
                 TextWrapping="NoWrap" VerticalAlignment="Center" />
    </Grid>

    <TextBlock Classes="row-desc" IsVisible="{Binding !HasShortcutMatches}"
               Text="{loc:Localize Sc_NoMatch}" />

    <ItemsControl ItemsSource="{Binding FilteredShortcutGroups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="14" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ShortcutGroup">
          <StackPanel Spacing="8">
            <TextBlock Classes="section-title" Text="{Binding Title}" />
            <Border Classes="table">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutItem">
                    <!-- 行高改为自适应:带生效条件的条目要在动作名下面多排一行备注,
                         写死 36px 会把备注裁掉。 -->
                    <Border MinHeight="36" Padding="12,7"
                            BorderBrush="{DynamicResource VelaBorderPrimary}"
                            BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Label}"
                                     Foreground="{DynamicResource VelaTextSecondary}"
                                     FontSize="{DynamicResource VelaFontSize12}"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="row-desc"
                                     IsVisible="{Binding HasNote}"
                                     Text="{Binding Note}" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}"
                                      VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Border Classes="keycap">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource VelaTextSecondary}"
                                           FontFamily="{DynamicResource VelaUiMonoFont}"
                                           FontSize="{DynamicResource VelaFontSize10}" FontWeight="Medium" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 平台差异:全局键位在三平台都是 Ctrl,只有终端上下文在 macOS 换成 Command
         (KeyboardShortcutService.RegisterMappings),故表里统一列 Ctrl,差异在这里说清。 -->
    <TextBlock Classes="row-desc" Text="{Binding ShortcutMacNote}" />
  </StackPanel>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:conv="using:VelaShell.Converters"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="VelaShell.Views.ProcessManagerView"
        x:DataType="vm:ProcessManagerViewModel"
        Icon="/Assets/velashell.ico"
        Title="{loc:Localize Cmd_ProcessManager}"
        Width="1000" Height="640"
        MinWidth="880" MinHeight="420"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None">

  <!-- 远端任务管理器:操作语义对齐 Windows 任务管理器的"详细信息"页 ——
       点列头排序、右键结束任务/进程树、更新速度可调、Del 结束任务、F5 立即刷新。

       圆角走本应用所有弹出窗体的同一套做法:窗口本身透明,里面画一张 8px 圆角卡片。
       靠 DWM 框架(主窗口那套)拿圆角对被拥有的弹出窗不生效,四角会是方的 —— 这正是
       之前只有这个窗口没圆角的原因。代价是没有系统阴影和贴靠布局面板,阴影自己画,
       缩放由四周的自绘抓取区负责。最大化时卡片改为无圆角、无外边距(见 code-behind)。 -->

  <Window.Styles>
    <!-- 标题栏三个窗口控制键,规格同主窗口的 VelaCaptionButton(那套主题定义在
         TitleBarView 内部,跨窗口取不到,这里本地重定义)。 -->
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <!-- 贴靠布局面板弹出时鼠标在非客户区,收不到 :pointerover;由 WndProc 打这个类补上反馈。 -->
    <Style Selector="Button.caption.nc-hover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <!-- 列头:整块可点、无按钮外观,与文件浏览器的 col-header 同规格。 -->
    <Style Selector="Button.col-header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.col-header:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <!-- 数值列表头右对齐,与数据单元格的 TextAlignment=Right 对齐到同一条边。 -->
    <Style Selector="Button.col-header.num">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.col-header TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 工具栏按钮 -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
    </Style>
    <!-- 树形视图的展开箭头 -->
    <Style Selector="Button.expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 资源占用条:CPU 与内存用不同色相,越过阈值转黄/红。
         warn/crit 写在 cpu/mem 之后,同权重下后者胜出,越界色才盖得住基色。 -->
    <Style Selector="ProgressBar.gauge">
      <Setter Property="Background" Value="{DynamicResource VelaGaugeTrack}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.gauge.cpu">
      <Setter Property="Foreground" Value="{DynamicResource VelaGaugeCpu}" />
    </Style>
    <Style Selector="ProgressBar.gauge.mem">
      <Setter Property="Foreground" Value="{DynamicResource VelaGaugeMemory}" />
    </Style>
    <Style Selector="ProgressBar.gauge.warn">
      <Setter Property="Foreground" Value="{DynamicResource VelaGaugeWarn}" />
    </Style>
    <Style Selector="ProgressBar.gauge.crit">
      <Setter Property="Foreground" Value="{DynamicResource VelaGaugeCritical}" />
    </Style>
    <!-- 概览条上的文字:标签与数值共用一套,字号字族一致,基线才对得齐。 -->
    <Style Selector="TextBlock.gauge-label">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.gauge-value">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaTerminalFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 数据行文本 -->
    <Style Selector="TextBlock.cell">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="{DynamicResource VelaTerminalFont}" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </Window.Styles>

  <Panel>
  <Border x:Name="RootCard"
          Margin="8"
          CornerRadius="8"
          ClipToBounds="True"
          Background="{DynamicResource VelaBgPage}"
          BorderBrush="{DynamicResource VelaBorderSecondary}"
          BorderThickness="1"
          BoxShadow="0 8 32 0 #80000000">
  <Grid RowDefinitions="34,Auto,Auto,*,26">

    <!-- 标题栏(自绘):按住可拖动,双击最大化/还原。
         CornerRadius 必须跟随外框的上方圆角 —— 方角的背景会盖住外框在圆角处的描边,
         看起来就像边框在四个角上断开了(设置页 RootBorder 同样的处理)。 -->
    <Border x:Name="TitleBarStrip" Grid.Row="0"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}"
            BorderThickness="0,0,0,1"
            CornerRadius="7,7,0,0"
            PointerPressed="Header_PointerPressed">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <pc:LucideIcon Width="14" Height="14"
                         Data="{StaticResource Icon.activity}"
                         Foreground="{DynamicResource VelaAccent}"
                         VerticalAlignment="Center" />
          <TextBlock Text="{Binding HostLabel}"
                     Foreground="{DynamicResource VelaTextPrimary}"
                     FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="caption" Click="Minimize_Click">
            <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.minus}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
          </Button>
          <Button x:Name="MaximizeButton" Classes="caption" Click="Maximize_Click">
            <pc:LucideIcon Width="10" Height="10" Data="{StaticResource Icon.square}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
          </Button>
          <Button Classes="caption caption-close" Click="Close_Click">
            <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.x}"
                           Foreground="{DynamicResource VelaTextSecondary}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 工具栏 -->
    <Border Grid.Row="1"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid ColumnDefinitions="260,*,Auto">
        <TextBox Grid.Column="0"
                 Text="{Binding SearchText}"
                 PlaceholderText="{loc:Localize Proc_SearchPlaceholder}"
                 Height="28" MinHeight="28" FontSize="11" Padding="8,0"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <CheckBox IsChecked="{Binding ShowTree}"
                    Content="{loc:Localize Proc_TreeView}"
                    FontSize="11"
                    Foreground="{DynamicResource VelaTextSecondary}"
                    VerticalAlignment="Center" />

          <CheckBox IsChecked="{Binding ShowKernelThreads}"
                    Content="{loc:Localize Proc_ShowKernelThreads}"
                    FontSize="11"
                    Foreground="{DynamicResource VelaTextSecondary}"
                    VerticalAlignment="Center" />

          <!-- 更新速度:对应任务管理器"查看 → 更新速度" -->
          <Button Classes="tool">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="{loc:Localize Proc_Speed}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SpeedLabel}"
                         Foreground="{DynamicResource VelaAccent}"
                         VerticalAlignment="Center" />
              <pc:LucideIcon Width="9" Height="9"
                             Data="{StaticResource Icon.chevron-down}"
                             Foreground="{DynamicResource VelaTextMuted}"
                             VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Localize Proc_SpeedHigh}"
                          Command="{Binding SetSpeedCommand}" CommandParameter="High" />
                <MenuItem Header="{loc:Localize Proc_SpeedNormal}"
                          Command="{Binding SetSpeedCommand}" CommandParameter="Normal" />
                <MenuItem Header="{loc:Localize Proc_SpeedLow}"
                          Command="{Binding SetSpeedCommand}" CommandParameter="Low" />
                <Separator />
                <MenuItem Header="{loc:Localize Proc_SpeedPaused}"
                          Command="{Binding SetSpeedCommand}" CommandParameter="Paused" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Classes="tool" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="F5">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <pc:LucideIcon Width="11" Height="11"
                             Data="{StaticResource Icon.refresh-cw}"
                             Foreground="{DynamicResource VelaTextSecondary}"
                             VerticalAlignment="Center" />
              <TextBlock Text="{loc:Localize Proc_Refresh}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="tool danger"
                  Command="{Binding EndTaskCommand}"
                  Content="{loc:Localize Proc_EndTask}"
                  ToolTip.Tip="Delete" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 概览条:全机 CPU / 内存 -->
    <Border Grid.Row="2"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
      <!-- 每个指标一格,格高固定 18:标签、数值、占用条都在同一个盒子里居中,
           而不是靠"两个文本框恰好等高"来对齐 —— 换字体或换 DPI 后前者依然成立。 -->
      <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,Auto,Auto" Height="18">
          <TextBlock x:Name="CpuSummaryLabel" Grid.Column="0"
                     Classes="gauge-label"
                     Text="{loc:Localize Proc_ColCpu}"
                     MinWidth="34" />
          <TextBlock Grid.Column="1" Classes="gauge-value"
                     Text="{Binding CpuSummary}"
                     MinWidth="46" Margin="8,0" />
          <ProgressBar x:Name="CpuGauge" Grid.Column="2"
                       Classes="gauge cpu"
                       Classes.warn="{Binding IsCpuWarn}"
                       Classes.crit="{Binding IsCpuCritical}"
                       Minimum="0" Maximum="100" Value="{Binding CpuPercent}"
                       Width="150" Height="10" />
        </Grid>
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" Height="18">
          <TextBlock Grid.Column="0" Classes="gauge-label"
                     Text="{loc:Localize Proc_ColMemory}"
                     MinWidth="34" />
          <TextBlock Grid.Column="1" Classes="gauge-value"
                     Text="{Binding MemoryPercentSummary}"
                     MinWidth="46" Margin="8,0" />
          <ProgressBar x:Name="MemoryGauge" Grid.Column="2"
                       Classes="gauge mem"
                       Classes.warn="{Binding IsMemoryWarn}"
                       Classes.crit="{Binding IsMemoryCritical}"
                       Minimum="0" Maximum="100" Value="{Binding MemoryPercent}"
                       Width="150" Height="10" />
          <TextBlock Grid.Column="3" Classes="gauge-value"
                     Foreground="{DynamicResource VelaTextSecondary}"
                     Text="{Binding MemorySummary}"
                     Margin="10,0,0,0" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 进程表 -->
    <Grid Grid.Row="3" RowDefinitions="26,*">

      <Border Grid.Row="0"
              Background="{DynamicResource VelaBgContentHeader}"
              BorderBrush="{DynamicResource VelaBorderSecondary}"
              BorderThickness="0,0,0,1"
              Padding="12,0">
        <!-- 数值列的表头必须与数据一样右对齐、且用同一个右边距,否则表头贴左、数字贴右,
             整张表看着就是错位的(截图里 PID/CPU/内存/线程/运行时长 全中招)。 -->
        <Grid x:Name="HeaderColumns" ColumnDefinitions="220,72,110,64,90,58,58,92,*">
          <Button Grid.Column="0" Classes="col-header" Command="{Binding SortCommand}" CommandParameter="name">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
              <TextBlock Text="{loc:Localize Proc_ColName}" />
              <TextBlock Text="{Binding NameSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="col-header num" Command="{Binding SortCommand}" CommandParameter="pid">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <TextBlock Text="{loc:Localize Proc_ColPid}" />
              <TextBlock Text="{Binding PidSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="col-header" Command="{Binding SortCommand}" CommandParameter="user">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
              <TextBlock Text="{loc:Localize Proc_ColUser}" />
              <TextBlock Text="{Binding UserSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="col-header num" Command="{Binding SortCommand}" CommandParameter="cpu"
                  ToolTip.Tip="{loc:Localize Proc_CpuNormalisedTip}">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <TextBlock Text="{loc:Localize Proc_ColCpu}" />
              <TextBlock Text="{Binding CpuSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="col-header num" Command="{Binding SortCommand}" CommandParameter="mem">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <TextBlock Text="{loc:Localize Proc_ColMemory}" />
              <TextBlock Text="{Binding MemSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Classes="col-header num" Command="{Binding SortCommand}" CommandParameter="threads">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <TextBlock Text="{loc:Localize Proc_ColThreads}" />
              <TextBlock Text="{Binding ThreadsSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="6" Classes="col-header" Command="{Binding SortCommand}" CommandParameter="state">
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
              <TextBlock Text="{loc:Localize Proc_ColState}" />
              <TextBlock Text="{Binding StateSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="7" Classes="col-header num" Command="{Binding SortCommand}" CommandParameter="time">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
              <TextBlock Text="{loc:Localize Proc_ColTime}" />
              <TextBlock Text="{Binding TimeSortGlyph}" Foreground="{DynamicResource VelaAccent}" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="8" Text="{loc:Localize Proc_ColCommand}"
                     Foreground="{DynamicResource VelaTextMuted}"
                     FontSize="10" LetterSpacing="1" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ListBox Grid.Row="1" x:Name="ProcessList"
               ItemsSource="{Binding Processes}"
               SelectedItem="{Binding SelectedProcess}"
               Background="Transparent"
               BorderThickness="0"
               IsVisible="{Binding !IsUnavailable}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="22" />
          </Style>
        </ListBox.Styles>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{loc:Localize Proc_EndTask}" Command="{Binding EndTaskCommand}" />
            <MenuItem Header="{loc:Localize Proc_EndTree}" Command="{Binding EndTaskTreeCommand}" />
            <MenuItem Header="{loc:Localize Proc_ForceEnd}" Command="{Binding ForceEndTaskCommand}" />
            <Separator />
            <MenuItem Header="{loc:Localize Proc_SetPriority}">
              <MenuItem Header="{loc:Localize Proc_PriorityRealtime}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="-20" />
              <MenuItem Header="{loc:Localize Proc_PriorityHigh}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="-10" />
              <MenuItem Header="{loc:Localize Proc_PriorityAboveNormal}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="-5" />
              <MenuItem Header="{loc:Localize Proc_PriorityNormal}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="0" />
              <MenuItem Header="{loc:Localize Proc_PriorityBelowNormal}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="5" />
              <MenuItem Header="{loc:Localize Proc_PriorityLow}"
                        Command="{Binding SetPriorityCommand}" CommandParameter="10" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Localize Proc_CopyCommand}" Command="{Binding CopyCommandLineCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProcessRowViewModel">
            <!-- 列宽必须与上面的 HeaderColumns 逐列一致,UI 测试会逐项比对。 -->
            <Grid x:Name="RowColumns" ColumnDefinitions="220,72,110,64,90,58,58,92,*"
                  ToolTip.Tip="{Binding CommandLine}">
              <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,8,0">
                <!-- 树形视图的缩进与展开箭头;平铺视图下整块隐藏,名称照旧从最左开始。 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            IsVisible="{Binding $parent[ListBox].((vm:ProcessManagerViewModel)DataContext).ShowTree}">
                  <Border Width="{Binding IndentWidth}" />
                  <Button Classes="expander"
                          IsVisible="{Binding HasChildren}"
                          Command="{Binding $parent[ListBox].((vm:ProcessManagerViewModel)DataContext).ToggleExpandCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding ExpanderGlyph}" FontSize="9"
                               Foreground="{DynamicResource VelaTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <!-- 叶子节点补一个等宽占位,同级的名称才对得齐。 -->
                  <Border Width="14" IsVisible="{Binding !HasChildren}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Name}"
                           Foreground="{DynamicResource VelaTextPrimary}" />
              </Grid>
              <TextBlock Grid.Column="1" Classes="cell num" Text="{Binding PidText}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="2" Classes="cell" Text="{Binding User}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="3" Classes="cell num" Text="{Binding CpuText}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="4" Classes="cell num" Text="{Binding MemoryText}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="5" Classes="cell num" Text="{Binding Threads}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="6" Classes="cell" Text="{Binding State}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="7" Classes="cell num" Text="{Binding ElapsedText}" Margin="0,0,12,0" />
              <TextBlock Grid.Column="8" Classes="cell" Text="{Binding CommandLine}"
                         Foreground="{DynamicResource VelaTextMuted}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 取不到数据时的占位说明,而不是一张空表 -->
      <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="360"
                  IsVisible="{Binding IsUnavailable}">
        <TextBlock Text="{loc:Localize Proc_Unavailable}"
                   Foreground="{DynamicResource VelaTextSecondary}"
                   FontSize="12" FontWeight="SemiBold"
                   TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Localize Proc_UnavailableHint}"
                   Foreground="{DynamicResource VelaTextMuted}"
                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- 状态栏。同上,圆角跟随外框下方两角。 -->
    <Border x:Name="StatusStrip" Grid.Row="4"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,7,7"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding CountSummary}"
                   Foreground="{DynamicResource VelaTextMuted}"
                   FontSize="10" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource VelaTextSecondary}"
                   FontSize="10" Margin="16,0"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringNotEmptyConverter.Instance}}" />
        <TextBlock Grid.Column="2" Text="{Binding CoresSummary}"
                   Foreground="{DynamicResource VelaTextMuted}"
                   FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
  </Border>

  <!-- 自绘窗口缩放抓取区(与 MainWindow 同规格):无边框窗口没有系统边框可拖,
       缺了这层窗口就完全不能缩放。铺满整个窗口,正好覆盖卡片外那圈阴影留白。
       最大化时由 code-behind 隐藏。 -->
  <Panel x:Name="ResizeGrips" ZIndex="200">
    <Border Tag="North" Height="5" VerticalAlignment="Top" Margin="10,0" Background="Transparent" Cursor="TopSide" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="South" Height="5" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" Cursor="BottomSide" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="West" Width="5" HorizontalAlignment="Left" Margin="0,10" Background="Transparent" Cursor="LeftSide" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="East" Width="5" HorizontalAlignment="Right" Margin="0,10" Background="Transparent" Cursor="RightSide" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeEdge_PointerPressed" />
    <Border Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeEdge_PointerPressed" />
  </Panel>
  </Panel>
</Window>

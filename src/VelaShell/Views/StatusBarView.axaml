<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pvm="using:VelaShell.Presentation.ViewModels"
             xmlns:pc="using:VelaShell.Controls.Controls"
             xmlns:loc="using:VelaShell.Localization"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="24"
             x:Class="VelaShell.Views.StatusBarView"
             x:DataType="pvm:StatusBarViewModel">

  <!-- 设计框 gzmsb:高 24px、背景 bg-sidebar、顶部 1px 边框、内边距 [0,12]、两端对齐。
       左侧 (1y2au,间距 14):wifi + "SSH • host:port" + | + 延迟(accent) + | + 运行时长。
       右侧 (4Cio1,间距 12):终端类型 | 尺寸 | CPU | 内存 | 网速 | 编码。 -->

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Background" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Height="24"
          Background="{DynamicResource VelaBgSidebar}"
          BorderBrush="{DynamicResource VelaBorderPrimary}"
          BorderThickness="0,1,0,0"
          Padding="12,0">
    <Grid ColumnDefinitions="Auto,*,Auto">

      <!-- 左侧分组(间距 14) -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
        <pc:LucideIcon Width="12" Height="12"
                       Data="{StaticResource Icon.wifi}"
                       Foreground="{DynamicResource VelaStatusConnected}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsConnected}" />
        <TextBlock Text="{Binding ConnectionInfo}"
                   Foreground="{DynamicResource VelaTextSecondary}"
                   IsVisible="{Binding ConnectionInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Classes="divider"
                IsVisible="{Binding Latency, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- 标签本地化(延迟/Latency)且仅数值上主题色。Run 之间不能换行,
             否则 XAML 空白折叠会在冒号前多出一个空格。 -->
        <TextBlock IsVisible="{Binding Latency, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><Run Text="{loc:Localize Latency}" Foreground="{DynamicResource VelaTextTertiary}" /><Run Text=": " Foreground="{DynamicResource VelaTextTertiary}" /><Run Text="{Binding Latency}" Foreground="{DynamicResource VelaAccent}" /></TextBlock>
        <Border Classes="divider"
                IsVisible="{Binding Uptime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Foreground="{DynamicResource VelaTextTertiary}"
                   Text="{Binding Uptime, StringFormat='↑ {0}'}"
                   IsVisible="{Binding Uptime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Foreground="{DynamicResource VelaTextSecondary}"
                   Text="{Binding StatusText}"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- 右侧分组(间距 12)。实时指标位于固定宽度的字段(终端类型 / 尺寸 / 编码)左侧,
           这样它们宽度变化时不会把静态文本挤来挤去(#4)。 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
        <!-- 后台活动圆环(插件装载/校验/预读等):排在本组最左端,于是它出现与消失时
             右侧那几个定宽字段相对窗口右缘纹丝不动 —— 只有它自己在长出来和缩回去。
             无活动时整块隐藏(含后面那条分隔线),状态栏回到干净状态。 -->
        <Button Classes="monitor" Padding="4,0" Height="20" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                IsVisible="{Binding HasBackgroundActivity}"
                ToolTip.Tip="{Binding BackgroundTooltip}" ToolTip.Placement="Left">
          <Button.Styles>
            <Style Selector="Button.monitor:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
            </Style>
          </Button.Styles>
          <Button.Flyout>
            <Flyout Placement="Top" HorizontalOffset="0">
              <StackPanel MinWidth="240" Spacing="8">
                <TextBlock Text="{loc:Localize BackgroundTasks}"
                           FontFamily="{DynamicResource VelaUiFont}"
                           FontSize="{DynamicResource VelaFontSize11}"
                           Foreground="{DynamicResource VelaTextTertiary}" />
                <ItemsControl ItemsSource="{Binding BackgroundActivities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:BackgroundActivityItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{Binding Title}"
                                     FontFamily="{DynamicResource VelaUiFont}"
                                     FontSize="{DynamicResource VelaFontSize11}"
                                     Foreground="{DynamicResource VelaTextPrimary}" />
                          <TextBlock Text="{Binding Detail}"
                                     IsVisible="{Binding HasDetail}"
                                     TextTrimming="CharacterEllipsis"
                                     FontFamily="{DynamicResource VelaUiMonoFont}"
                                     FontSize="{DynamicResource VelaFontSize10}"
                                     Foreground="{DynamicResource VelaTextMuted}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                   Text="{Binding Progress}"
                                   IsVisible="{Binding HasProgress}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource VelaUiMonoFont}"
                                   FontSize="{DynamicResource VelaFontSize10}"
                                   Foreground="{DynamicResource VelaAccent}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <pc:CircularProgressRing Width="12" Height="12" StrokeThickness="2"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="{Binding IsBackgroundIndeterminate}"
                                     Value="{Binding BackgroundProgress}"
                                     TrackBrush="{DynamicResource VelaBorderSecondary}"
                                     ArcBrush="{DynamicResource VelaAccent}" />
            <TextBlock Text="{Binding BackgroundSummary}"
                       Foreground="{DynamicResource VelaTextSecondary}" />
          </StackPanel>
        </Button>
        <Border Classes="divider" IsVisible="{Binding HasBackgroundActivity}" />

        <!-- 实时指标收进资源监视窗口:状态栏只留一个图标按钮,点击开窗;
             悬停仍给出 CPU 逐核心 / 内存含交换 / 磁盘逐挂载点 / 网速逐网卡的完整详情。 -->
        <Button Classes="monitor" Padding="4,0" Height="20" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                ToolTip.Tip="{Binding MetricsTooltip}" ToolTip.Placement="Left"
                Command="{Binding OpenResourceMonitorCommand}">
          <Button.Styles>
            <Style Selector="Button.monitor:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
            </Style>
            <Style Selector="Button.monitor:disabled">
              <Setter Property="Opacity" Value="0.55" />
            </Style>
          </Button.Styles>
          <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.square-activity}"
                         Foreground="{DynamicResource VelaAccent}" VerticalAlignment="Center" />
        </Button>
        <Border Classes="divider" />
        <TextBlock Text="{Binding TerminalType}"
                   Foreground="{DynamicResource VelaTextMuted}" />
        <Border Classes="divider" />
        <TextBlock Text="{Binding WindowSize}"
                   Foreground="{DynamicResource VelaTextMuted}" />
        <Border Classes="divider" />
        <!-- 编码可点:弹出菜单当场切当前会话的编码。远端 locale 与本地不一致时,
             一屏乱码到底是 GBK 还是 UTF-8,试一下比翻设置快得多;只影响本会话,不写回设置。 -->
        <Button Classes="monitor" Padding="4,0" Height="20" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                ToolTip.Tip="{loc:Localize Status_ChangeEncoding}">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding AvailableEncodings}" Placement="Top">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Setter Property="Header" Value="{Binding}" />
                  <Setter Property="Command"
                          Value="{Binding $parent[UserControl].((pvm:StatusBarViewModel)DataContext).ChangeEncodingCommand}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
          <TextBlock Text="{Binding Encoding}"
                     Foreground="{DynamicResource VelaTextMuted}" />
        </Button>
        <!-- 选区字符数:只有真的选中了东西才占位。 -->
        <Border Classes="divider" IsVisible="{Binding HasSelection}" />
        <TextBlock Text="{Binding SelectionLabel}"
                   Foreground="{DynamicResource VelaTextSecondary}"
                   IsVisible="{Binding HasSelection}" />
      </StackPanel>

    </Grid>
  </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VelaShell.ViewModels"
        xmlns:behaviors="using:VelaShell.Behaviors"
        xmlns:conv="using:VelaShell.Converters"
        xmlns:pc="using:VelaShell.Controls.Controls"
        xmlns:loc="using:VelaShell.Localization"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="750"
        x:Class="VelaShell.Views.ResourceMonitorWindow"
        x:DataType="vm:ResourceMonitorWindowViewModel"
        Icon="/Assets/velashell.ico"
        Title="{loc:Localize Monitor_Title}"
        Width="1280" Height="820"
        MinWidth="960" MinHeight="620"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None">

  <!-- 资源监视窗口(设计帧 XQTSJ/l6zvbI/j0NcGX/St1My/gwmD7/OHvJS)。窗体规格与任务管理器、
       链路追踪一致:透明窗口 + 自绘 8px 圆角卡片 + 自绘缩放抓取区。
       头部 56、左导航 200、内容区 padding 16 / 卡片间距 12,均按设计规范。 -->

  <Window.Styles>
    <Style Selector="Button.caption">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>

    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderSecondary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize11}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 左导航项:3px 强调竖条 + 46×30 迷你趋势 + 名称/读数 -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="5,0,10,0" />
      <Setter Property="Height" Value="50" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <!-- 内容必须纵向拉满:卡片里的迷你曲线走 DockPanel 填充,内容居中的话它会被压成 0 高。 -->
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>

    <Style Selector="Button.seg">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.seg.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaAccent}" />
    </Style>
    <Style Selector="Button.seg.active">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccentForeground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 分段控件里的单个选项(逻辑处理器的视图/排序切换) -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- 选中态:底色仍是中性的 bg-active,只把文字提成主题色 —— 整块填充强调色在这么小的
         分段控件上太抢眼,与旁边的排序分段也不一致。 -->
    <Style Selector="Button.chip.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgActive}" />
    </Style>
    <Style Selector="Button.chip.active">
      <Setter Property="Foreground" Value="{DynamicResource VelaAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>

    <!-- 列表里的可选卡片(物理磁盘 / GPU / 网卡):按钮自身就是那张卡,圆角与描边都在它身上 -->
    <Style Selector="Button.item">
      <Setter Property="Background" Value="{DynamicResource VelaBgPage}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <!-- 内边距靠内容自身的 Margin 给:按钮模板的 ContentPresenter 未必接管 Padding,
           靠它会让内容直接顶到边框(右侧读数被描边切掉半个字)。 -->
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.item /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource VelaBgHover}" />
    </Style>
    <Style Selector="Button.item.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource VelaAccent}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource VelaBgInput}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.plot">
      <Setter Property="Background" Value="{DynamicResource VelaBgPage}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VelaBorderPrimary}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.card-title">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize12}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.card-sub">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.card-value">
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize13}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.axis">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize9}" />
      <Setter Property="Margin" Value="8,6" />
    </Style>
    <!-- 压在曲线上的刻度:面积填充铺满时,muted 小字会糊进去几乎看不见 —— 垫一层底片再写。 -->
    <Style Selector="TextBlock.axis.onplot">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="Background" Value="{DynamicResource VelaChartLabelBg}" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="6,5" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- 小号文字统一行高:界面字体与等宽字体的默认行框高度差一两像素,各自居中就会错行
         (同一排里"已用"比"4.2 GB"低一像素)。行高取自字号令牌,用户放大界面字号时同比例长大,
         不会写死。 -->
    <Style Selector="TextBlock.legend">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="LineHeight" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.col">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextMuted}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="LineHeight" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="LineHeight" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextSecondary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="LineHeight" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="Foreground" Value="{DynamicResource VelaTextPrimary}" />
      <Setter Property="FontFamily" Value="{DynamicResource VelaUiMonoFont}" />
      <Setter Property="FontSize" Value="{DynamicResource VelaFontSize10}" />
      <Setter Property="LineHeight" Value="{DynamicResource VelaFontSize14}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 使用率读数跟着占用条一起转色:条子红了、数字还是白的,一眼看不出哪块盘要满。 -->
    <Style Selector="TextBlock.pct">
      <Setter Property="Foreground" Value="{DynamicResource VelaShellGreen}" />
    </Style>
    <Style Selector="TextBlock.pct.warn">
      <Setter Property="Foreground" Value="{DynamicResource VelaWarning}" />
    </Style>
    <Style Selector="TextBlock.pct.crit">
      <Setter Property="Foreground" Value="{DynamicResource VelaError}" />
    </Style>

    <!-- 隔行底纹:ItemsControl 的容器是 ContentPresenter,:nth-child 只能挂在容器上 ——
         挂在模板里那层 Border 上永远是"第 1 个子元素",条纹出不来。 -->
    <Style Selector="ItemsControl#PartitionList > ContentPresenter:nth-child(2n) Border.row">
      <Setter Property="Background" Value="{DynamicResource VelaBgPage}" />
    </Style>
    <Style Selector="Rectangle.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="2" />
      <Setter Property="RadiusX" Value="1" />
      <Setter Property="RadiusY" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border x:Name="RootCard"
            Margin="8" CornerRadius="8" ClipToBounds="True"
            Background="{DynamicResource VelaBgSurface}"
            BorderBrush="{DynamicResource VelaBorderSecondary}"
            BorderThickness="1"
            BoxShadow="0 8 32 0 #80000000">
      <Grid RowDefinitions="56,*">

        <!-- ── 头部 ── -->
        <Border x:Name="TitleBarStrip" Grid.Row="0"
                Background="{DynamicResource VelaBgSurface}"
                BorderBrush="{DynamicResource VelaBorderPrimary}"
                BorderThickness="0,0,0,1"
                CornerRadius="7,7,0,0"
                PointerPressed="Header_PointerPressed">
          <Grid ColumnDefinitions="*,Auto" Margin="20,0,0,0">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{loc:Localize Monitor_Title}"
                         Foreground="{DynamicResource VelaTextPrimary}"
                         FontFamily="{DynamicResource VelaUiFont}"
                         FontSize="{DynamicResource VelaFontSize16}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding HeaderSubtitle}"
                         Foreground="{DynamicResource VelaTextMuted}"
                         FontFamily="{DynamicResource VelaUiMonoFont}"
                         FontSize="{DynamicResource VelaFontSize10}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0">
                <!-- 主机标识:连通时绿点 -->
                <Border Background="{DynamicResource VelaBgInput}"
                        BorderBrush="{DynamicResource VelaBorderSecondary}" BorderThickness="1"
                        CornerRadius="4" Padding="8,5" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource VelaStatusConnected}"
                             IsVisible="{Binding IsAvailable}" />
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{DynamicResource VelaStatusDisconnected}"
                             IsVisible="{Binding !IsAvailable}" />
                    <TextBlock Text="{Binding HostName}" Classes="legend" />
                  </StackPanel>
                </Border>
                <Button Classes="tool" Command="{Binding TogglePauseCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <pc:LucideIcon Width="12" Height="12" VerticalAlignment="Center"
                                   Data="{StaticResource Icon.pause}"
                                   Foreground="{DynamicResource VelaTextSecondary}"
                                   IsVisible="{Binding !IsPaused}" />
                    <pc:LucideIcon Width="12" Height="12" VerticalAlignment="Center"
                                   Data="{StaticResource Icon.play}"
                                   Foreground="{DynamicResource VelaAccent}"
                                   IsVisible="{Binding IsPaused}" />
                    <TextBlock Text="{loc:Localize Monitor_Pause}" VerticalAlignment="Center"
                               IsVisible="{Binding !IsPaused}" />
                    <TextBlock Text="{loc:Localize Monitor_Resume}" VerticalAlignment="Center"
                               IsVisible="{Binding IsPaused}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Button Classes="caption" Click="Minimize_Click">
                  <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.minus}"
                                 Foreground="{DynamicResource VelaTextSecondary}" />
                </Button>
                <Button Classes="caption" Click="Maximize_Click">
                  <pc:LucideIcon Width="10" Height="10" Data="{StaticResource Icon.square}"
                                 Foreground="{DynamicResource VelaTextSecondary}" />
                </Button>
                <Button Classes="caption caption-close" Click="Close_Click">
                  <pc:LucideIcon Width="12" Height="12" Data="{StaticResource Icon.x}"
                                 Foreground="{DynamicResource VelaTextSecondary}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── 主体:左导航 + 内容 ── -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">

          <Border Grid.Column="0"
                  Background="{DynamicResource VelaBgSidebar}"
                  BorderBrush="{DynamicResource VelaBorderPrimary}"
                  BorderThickness="0,0,1,0">
            <DockPanel Margin="8,10">

              <!-- 采样间隔与说明固定在底部 -->
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="5,8,5,0">
                <TextBlock Text="{loc:Localize Monitor_SampleInterval}" Classes="col" />
                <Border Background="{DynamicResource VelaBgInput}"
                        BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1"
                        CornerRadius="4" Padding="2">
                  <UniformGrid Columns="4">
                    <Button Classes="seg" Classes.active="{Binding Is1S}" Content="1s"
                            Command="{Binding SetIntervalCommand}" CommandParameter="1" />
                    <Button Classes="seg" Classes.active="{Binding Is2S}" Content="2s"
                            Command="{Binding SetIntervalCommand}" CommandParameter="2" />
                    <Button Classes="seg" Classes.active="{Binding Is5S}" Content="5s"
                            Command="{Binding SetIntervalCommand}" CommandParameter="5" />
                    <Button Classes="seg" Classes.active="{Binding Is10S}" Content="10s"
                            Command="{Binding SetIntervalCommand}" CommandParameter="10" />
                  </UniformGrid>
                </Border>
                <TextBlock Text="{loc:Localize Monitor_Hint}"
                           Foreground="{DynamicResource VelaTextMuted}"
                           FontFamily="{DynamicResource VelaUiFont}"
                           FontSize="{DynamicResource VelaFontSize9}"
                           TextWrapping="Wrap" LineHeight="14" />
              </StackPanel>

              <StackPanel Spacing="4">
                <!-- 总览 -->
                <Button Classes="nav" Classes.active="{Binding IsOverview}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Overview">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource VelaAccent}"
                               IsVisible="{Binding IsOverview}" />
                    <Border Grid.Column="2" Background="{DynamicResource VelaBgPage}" CornerRadius="3"
                            Height="30" VerticalAlignment="Center">
                      <pc:LucideIcon Width="16" Height="16" Data="{StaticResource Icon.layout-grid}"
                                     Foreground="{DynamicResource VelaAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Overview}" Classes="card-title" />
                      <TextBlock Text="{Binding HostName}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- CPU -->
                <Button Classes="nav" Classes.active="{Binding IsCpuPage}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Cpu">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{DynamicResource VelaShellBlue}"
                               IsVisible="{Binding IsCpuPage}" />
                    <Border Grid.Column="2" Classes="plot" Height="30" VerticalAlignment="Center">
                      <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100" GridRows="0" GridColumns="0">
                        <pc:ChartSeries Values="{Binding CpuHistory.Values}" StrokeThickness="1.2"
                                        Stroke="{DynamicResource VelaShellBlue}"
                                        Fill="{DynamicResource VelaShellBlueDim}" />
                      </pc:TimeSeriesChart>
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Cpu}" Classes="card-title" />
                      <TextBlock Text="{Binding NavCpuSub}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- GPU(未探测到 GPU 时整项隐藏) -->
                <Button Classes="nav" Classes.active="{Binding IsGpuPage}" IsVisible="{Binding HasGpu}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Gpu">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{DynamicResource VelaShellMagenta}"
                               IsVisible="{Binding IsGpuPage}" />
                    <Border Grid.Column="2" Classes="plot" Height="30" VerticalAlignment="Center">
                      <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100" GridRows="0" GridColumns="0">
                        <pc:ChartSeries Values="{Binding SelectedGpu.UtilHistory.Values}" StrokeThickness="1.2"
                                        Stroke="{DynamicResource VelaShellMagenta}"
                                        Fill="{DynamicResource VelaShellMagentaDim}" />
                      </pc:TimeSeriesChart>
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Gpu}" Classes="card-title" />
                      <TextBlock Text="{Binding NavGpuSub}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 内存 -->
                <Button Classes="nav" Classes.active="{Binding IsMemoryPage}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Memory">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{DynamicResource VelaShellYellow}"
                               IsVisible="{Binding IsMemoryPage}" />
                    <Border Grid.Column="2" Classes="plot" Height="30" VerticalAlignment="Center">
                      <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="{Binding MemoryTotalBytes}"
                                          GridRows="0" GridColumns="0">
                        <pc:ChartSeries Values="{Binding MemoryHistory.Values}" StrokeThickness="1.2"
                                        Stroke="{DynamicResource VelaShellYellow}"
                                        Fill="{DynamicResource VelaShellYellowDim}" />
                      </pc:TimeSeriesChart>
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Memory}" Classes="card-title" />
                      <TextBlock Text="{Binding NavMemorySub}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 磁盘 -->
                <Button Classes="nav" Classes.active="{Binding IsDiskPage}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Disk">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{DynamicResource VelaShellGreen}"
                               IsVisible="{Binding IsDiskPage}" />
                    <Border Grid.Column="2" Classes="plot" Height="30" VerticalAlignment="Center">
                      <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="0" GridRows="0" GridColumns="0">
                        <pc:ChartSeries Values="{Binding DiskReadHistory.Values}" StrokeThickness="1.2"
                                        Stroke="{DynamicResource VelaShellGreen}"
                                        Fill="{DynamicResource VelaShellGreenDim}" />
                      </pc:TimeSeriesChart>
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Disk}" Classes="card-title" />
                      <TextBlock Text="{Binding NavDiskSub}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>

                <!-- 网络 -->
                <Button Classes="nav" Classes.active="{Binding IsNetworkPage}"
                        Command="{Binding SelectPageCommand}" CommandParameter="Network">
                  <Grid ColumnDefinitions="3,7,46,7,*">
                    <Rectangle Grid.Column="0" Width="3" Height="22" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Center" Fill="{DynamicResource VelaShellCyan}"
                               IsVisible="{Binding IsNetworkPage}" />
                    <Border Grid.Column="2" Classes="plot" Height="30" VerticalAlignment="Center">
                      <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="0" GridRows="0" GridColumns="0">
                        <pc:ChartSeries Values="{Binding NetRxHistory.Values}" StrokeThickness="1.2"
                                        Stroke="{DynamicResource VelaShellCyan}"
                                        Fill="{DynamicResource VelaShellCyanDim}" />
                      </pc:TimeSeriesChart>
                    </Border>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{loc:Localize Monitor_Network}" Classes="card-title" />
                      <TextBlock Text="{Binding NavNetworkSub}" Classes="axis" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- ── 内容区 ── -->
          <Panel Grid.Column="1">

            <!-- 不可用占位(会话断开 / 非 Linux 主机) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !IsAvailable}">
              <pc:LucideIcon Width="28" Height="28" Data="{StaticResource Icon.square-activity}"
                             Foreground="{DynamicResource VelaTextMuted}" HorizontalAlignment="Center" />
              <TextBlock Text="{loc:Localize Monitor_Unavailable}" Classes="card-sub"
                         HorizontalAlignment="Center" />
            </StackPanel>

            <Grid IsVisible="{Binding IsAvailable}">

              <!-- ══ 总览:有 GPU 时 3 × 2,没有就回落 2 × 2 ══
                   用 UniformGrid 而不是固定网格:隐藏的 GPU 卡会被跳过,其余卡自动补位,
                   否则右侧会空出两块(固定 Grid 的行列位置是写死的)。 -->
              <UniformGrid Margin="10" IsVisible="{Binding IsOverview}"
                           Columns="{Binding OverviewColumns}">

                <Border Classes="card" Margin="6">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.cpu}"
                                       Foreground="{DynamicResource VelaShellBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Cpu}" Classes="card-title" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding CpuText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellBlue}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CpuBreakdownText}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100"
                                            GridBrush="{DynamicResource VelaBorderPrimary}">
                          <pc:ChartSeries Values="{Binding CpuHistory.Values}"
                                          Stroke="{DynamicResource VelaShellBlue}"
                                          Fill="{DynamicResource VelaShellBlueDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="100%" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Classes="axis onplot" Text="{Binding HistoryWindowText}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <Border Classes="card" Margin="6" IsVisible="{Binding HasGpu}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.microchip}"
                                       Foreground="{DynamicResource VelaShellMagenta}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Gpu}" Classes="card-title" />
                        <TextBlock Text="{Binding SelectedGpu.Label}" Classes="card-sub" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedGpu.UtilText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellMagenta}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding NavGpuSub}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100"
                                            GridBrush="{DynamicResource VelaBorderPrimary}">
                          <pc:ChartSeries Values="{Binding SelectedGpu.UtilHistory.Values}"
                                          Stroke="{DynamicResource VelaShellMagenta}"
                                          Fill="{DynamicResource VelaShellMagentaDim}" />
                          <pc:ChartSeries Values="{Binding SelectedGpu.MemBandwidthHistory.Values}"
                                          Stroke="{DynamicResource VelaShellBlue}"
                                          Fill="{DynamicResource VelaShellSubtleDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="100%" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <Border Classes="card" Margin="6" IsVisible="{Binding HasGpu}">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.layers}"
                                       Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Vram}" Classes="card-title" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SelectedGpu.MemPercentText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellCyan}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SelectedGpu.MemText}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}"
                                            Maximum="{Binding SelectedGpu.MemTotalBytes}"
                                            GridBrush="{DynamicResource VelaBorderPrimary}">
                          <pc:ChartSeries Values="{Binding SelectedGpu.MemHistory.Values}"
                                          Stroke="{DynamicResource VelaShellCyan}"
                                          Fill="{DynamicResource VelaShellCyanDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <Border Classes="card" Margin="6">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.memory-stick}"
                                       Foreground="{DynamicResource VelaShellYellow}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Memory}" Classes="card-title" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellYellow}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SwapText}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="{Binding MemoryTotalBytes}"
                                            GridBrush="{DynamicResource VelaBorderPrimary}">
                          <pc:ChartSeries Values="{Binding CacheHistory.Values}"
                                          Stroke="{DynamicResource VelaShellSubtle}"
                                          Fill="{DynamicResource VelaShellSubtleDim}" />
                          <pc:ChartSeries Values="{Binding MemoryHistory.Values}"
                                          Stroke="{DynamicResource VelaShellYellow}"
                                          Fill="{DynamicResource VelaShellYellowDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <Border Classes="card" Margin="6">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.hard-drive}"
                                       Foreground="{DynamicResource VelaShellGreen}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Disk}" Classes="card-title" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding DiskThroughputText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellGreen}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding DiskThroughputText}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="0"
                                            GridBrush="{DynamicResource VelaBorderPrimary}">
                          <pc:ChartSeries Values="{Binding DiskReadHistory.Values}"
                                          Stroke="{DynamicResource VelaShellGreen}"
                                          Fill="{DynamicResource VelaShellGreenDim}" />
                          <pc:ChartSeries Values="{Binding DiskWriteHistory.Values}"
                                          Stroke="{DynamicResource VelaShellMagenta}"
                                          Fill="{DynamicResource VelaShellMagentaDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <Border Classes="card" Margin="6">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.network}"
                                       Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_Network}" Classes="card-title" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding NetThroughputText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellCyan}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding NetThroughputText}" Classes="meta" Margin="0,8,0,0" />
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="0" Mirrored="True"
                                            GridBrush="{DynamicResource VelaBorderPrimary}"
                                            MidlineBrush="{DynamicResource VelaBorderSecondary}">
                          <pc:ChartSeries Values="{Binding NetRxHistory.Values}"
                                          Stroke="{DynamicResource VelaShellCyan}"
                                          Fill="{DynamicResource VelaShellCyanDim}" />
                          <pc:ChartSeries Values="{Binding NetTxHistory.Values}" Mirror="True"
                                          Stroke="{DynamicResource VelaShellMagenta}"
                                          Fill="{DynamicResource VelaShellMagentaDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Down}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Up}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>
              </UniformGrid>

              <!-- ══ CPU ══ -->
              <Grid Margin="16" IsVisible="{Binding IsCpuPage}" RowDefinitions="230,12,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,12,250">
                  <Border Classes="card" Grid.Column="0">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.cpu}"
                                         Foreground="{DynamicResource VelaShellBlue}" VerticalAlignment="Center" />
                          <TextBlock Text="{loc:Localize Monitor_TotalUsage}" Classes="card-title" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" Classes="card-value"
                                   Foreground="{DynamicResource VelaShellBlue}" />
                      </Grid>
                      <!-- 图例左对齐,细分读数压在右侧同一行 -->
                      <Panel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Classes="dot" Fill="{DynamicResource VelaShellBlue}" />
                            <TextBlock Text="{loc:Localize Monitor_TotalUsage}" Classes="legend" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Classes="dot" Fill="{DynamicResource VelaShellCyan}" />
                            <TextBlock Text="{loc:Localize Monitor_UserSpace}" Classes="legend" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Rectangle Classes="dot" Fill="{DynamicResource VelaShellMagenta}" />
                            <TextBlock Text="{loc:Localize Monitor_KernelSpace}" Classes="legend" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding CpuBreakdownText}" Classes="meta"
                                   HorizontalAlignment="Right" />
                      </Panel>
                      <Border Classes="plot">
                        <Panel>
                          <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100"
                                              GridBrush="{DynamicResource VelaBorderPrimary}">
                            <pc:ChartSeries Values="{Binding CpuHistory.Values}"
                                            Stroke="{DynamicResource VelaShellBlue}"
                                            Fill="{DynamicResource VelaShellBlueDim}" />
                            <pc:ChartSeries Values="{Binding CpuUserHistory.Values}"
                                            Stroke="{DynamicResource VelaShellCyan}"
                                            Fill="{DynamicResource VelaShellCyanDim}" />
                            <pc:ChartSeries Values="{Binding CpuSystemHistory.Values}"
                                            Stroke="{DynamicResource VelaShellMagenta}"
                                            Fill="{DynamicResource VelaShellMagentaDim}" />
                          </pc:TimeSeriesChart>
                          <TextBlock Classes="axis onplot" Text="100%" HorizontalAlignment="Left" VerticalAlignment="Top" />
                          <TextBlock Classes="axis onplot" Text="{Binding HistoryWindowText}"
                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                          <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                      </Border>
                    </DockPanel>
                  </Border>

                  <Border Classes="card" Grid.Column="2">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Text="{Binding HostName}" Classes="card-title" Margin="0,0,0,4" />
                      <!-- 型号名整行独占并换行:"Intel(R) Core(TM) i9-14900HX @ 2.20GHz" 这种
                           长度塞进右对齐的键值行只会剩个省略号。 -->
                      <TextBlock DockPanel.Dock="Top" Text="{Binding CpuModelText}"
                                 IsVisible="{Binding HasCpuModel}"
                                 Classes="val" TextWrapping="Wrap" Margin="0,0,0,7" />
                      <!-- 机器信息:行等高铺满整卡,别再塞第二块内容 ——
                           CPU 占用最高的进程在"内存"页的进程表里已经有更完整的一份。 -->
                      <ItemsControl ItemsSource="{Binding CpuDetails}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KeyValueRow">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Key}" Classes="key" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="val"
                                         TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                  </Border>
                </Grid>

                <Border Classes="card" Grid.Row="2">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.grid-3x3}"
                                       Foreground="{DynamicResource VelaShellBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_LogicalProcessors}" Classes="card-title" />
                        <TextBlock Text="{Binding CoreSubtitle}" Classes="card-sub" />
                      </StackPanel>
                      <!-- 排序 + 视图两个分段控件(设计稿 CPU 页右上角) -->
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource VelaBgPage}" CornerRadius="4" Padding="2"
                                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="chip" Classes.active="{Binding IsSortByIndex}"
                                    Content="{loc:Localize Monitor_SortByIndex}"
                                    Command="{Binding SetCoreSortCommand}" CommandParameter="Index" />
                            <Button Classes="chip" Classes.active="{Binding IsSortByLoad}"
                                    Content="{loc:Localize Monitor_SortByLoad}"
                                    Command="{Binding SetCoreSortCommand}" CommandParameter="Load" />
                          </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource VelaBgPage}" CornerRadius="4" Padding="2"
                                BorderBrush="{DynamicResource VelaBorderPrimary}" BorderThickness="1">
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="chip" Classes.active="{Binding IsHeatView}"
                                    Content="{loc:Localize Monitor_ViewHeat}"
                                    Command="{Binding SetCoreViewCommand}" CommandParameter="Heat" />
                            <Button Classes="chip" Classes.active="{Binding IsSparkView}"
                                    Content="{loc:Localize Monitor_ViewSpark}"
                                    Command="{Binding SetCoreViewCommand}" CommandParameter="Spark" />
                            <Button Classes="chip" Classes.active="{Binding IsListView}"
                                    Content="{loc:Localize Monitor_ViewList}"
                                    Command="{Binding SetCoreViewCommand}" CommandParameter="List" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                    <!-- 五级色阶图例(只有热力图需要),左对齐 -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"
                                HorizontalAlignment="Left" IsVisible="{Binding IsHeatView}">
                      <!-- 这一排其余文字都是等宽字体:标签也跟着用等宽,免得界面字体的行框
                           把"负载"两个字顶得比色阶读数低一像素。 -->
                      <TextBlock Text="{loc:Localize Monitor_LoadLegend}" Classes="cell"
                                 Foreground="{DynamicResource VelaTextMuted}" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource VelaHeat1}" />
                        <TextBlock Text="&lt;10%" Classes="cell" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource VelaHeat2}" />
                        <TextBlock Text="10-30%" Classes="cell" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource VelaHeat3}" />
                        <TextBlock Text="30-60%" Classes="cell" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource VelaHeat4}" />
                        <TextBlock Text="60-85%" Classes="cell" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource VelaHeat5}" />
                        <TextBlock Text="&gt;85%" Classes="cell" />
                      </StackPanel>
                    </StackPanel>
                    <Panel>
                      <!-- 热力图 -->
                      <!-- 把视口高度喂给网格,格子才能铺满容器:控件在 ScrollViewer 里量到的
                           可用高度是无限大,不给它就只能退回最小格高,核心少时一片空白。 -->
                      <ScrollViewer x:Name="HeatScroller"
                                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding IsHeatView}">
                        <pc:UsageHeatGrid Margin="0,0,14,0" Values="{Binding CorePercents}" Labels="{Binding CoreLabels}"
                                          ViewportHeight="{Binding #HeatScroller.Viewport.Height}"
                                          MaxCellHeight="200" MaxCellWidth="360"
                                          Revision="{Binding Revision}"
                                          SelectedIndex="{Binding SelectedCoreIndex, Mode=TwoWay}"
                                          FontFamily="{DynamicResource VelaUiMonoFont}"
                                          LabelBrush="{DynamicResource VelaTextSecondary}"
                                          SelectionBrush="{DynamicResource VelaAccent}"
                                          Level1Brush="{DynamicResource VelaHeat1}"
                                          Level2Brush="{DynamicResource VelaHeat2}"
                                          Level3Brush="{DynamicResource VelaHeat3}"
                                          Level4Brush="{DynamicResource VelaHeat4}"
                                          Level5Brush="{DynamicResource VelaHeat5}" />
                      </ScrollViewer>

                      <!-- 迷你折线:一格一条该核心的 60 秒趋势 -->
                      <ScrollViewer x:Name="SparkScroller"
                                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding IsSparkView}">
                        <pc:UsageHeatGrid Margin="0,0,14,0" Mode="Sparkline"
                                          Values="{Binding CorePercents}" Labels="{Binding CoreLabels}"
                                          Histories="{Binding CoreHistories}" Revision="{Binding Revision}"
                                          ViewportHeight="{Binding #SparkScroller.Viewport.Height}"
                                          SelectedIndex="{Binding SelectedCoreIndex, Mode=TwoWay}"
                                          MinCellHeight="48" MaxCellHeight="220"
                                          MinCellWidth="86" MaxCellWidth="420"
                                          FontFamily="{DynamicResource VelaUiMonoFont}"
                                          LabelBrush="{DynamicResource VelaTextMuted}"
                                          SelectionBrush="{DynamicResource VelaAccent}"
                                          CellBackground="{DynamicResource VelaBgPage}"
                                          LabelBackground="{DynamicResource VelaChartLabelBg}"
                                          LineBrush="{DynamicResource VelaShellBlue}"
                                          AreaBrush="{DynamicResource VelaShellBlueDim}" />
                      </ScrollViewer>

                      <!-- 列表:逐核心一行,大量核心时靠虚拟化保持流畅 -->
                      <DockPanel IsVisible="{Binding IsListView}">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="120,*,80" Margin="0,0,14,4">
                          <TextBlock Text="{loc:Localize Monitor_ColCore}" Classes="col" />
                          <TextBlock Grid.Column="1" Text="{loc:Localize Monitor_ColLoad}" Classes="col" />
                          <TextBlock Grid.Column="2" Text="%" Classes="col" TextAlignment="Right" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding CoreRows}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CoreRow">
                                <Grid ColumnDefinitions="120,*,80" Height="24">
                                  <TextBlock Text="{Binding Label}" Classes="cell"
                                             Foreground="{DynamicResource VelaTextPrimary}" />
                                  <pc:MeterBar Grid.Column="1" Height="6" HorizontalAlignment="Stretch"
                                               Margin="0,0,12,0" Value="{Binding Percent}"
                                               TrackBrush="{DynamicResource VelaGaugeTrack}"
                                               FillBrush="{DynamicResource VelaShellBlue}"
                                               WarnBrush="{DynamicResource VelaWarning}"
                                               CritBrush="{DynamicResource VelaError}" />
                                  <TextBlock Grid.Column="2" Text="{Binding PercentText}" Classes="cell"
                                             TextAlignment="Right" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Panel>
                  </DockPanel>
                </Border>
              </Grid>

              <!-- ══ GPU ══ -->
              <!-- 与网络页同构:卡片条 / 两张曲线 / GPU 详情(整行、Auto 高)/ GPU 进程(整行)。
                   详情与进程原来是左右两列,窗口一放大两张卡各自被拉高,内容却只有那几行,
                   中间摊出大片空白。曲线与进程表同样按 2:1 分剩余高度(理由见网络页)。 -->
              <Grid Margin="16" IsVisible="{Binding IsGpuPage}" RowDefinitions="Auto,12,2*,12,Auto,12,*">
                <!-- 横向卡片条。两处必须成对出现,缺一个就是一个已修过的老毛病:
                     · HorizontalWheelScroll.Enabled —— 没有它,滚轮在这条上完全不动(Avalonia 只把
                       滚轮的横向分量算进横向偏移,普通鼠标压根不产生横向分量),只能去拖那条滚动条;
                     · ItemsControl 底部 16px 留白 —— 悬浮式横向滚动条不占布局高度,直接压在卡片
                       最后 16px 上(实测 bar=(0,116,870,16) 对 132 高的卡片),把底排读数遮掉半行。
                     留白给在内容的 Margin 上而不是 ScrollViewer.Padding:后者会让子项按"视口宽减留白"
                     排布却按视口宽报告尺寸,末尾那张卡会被裁掉一条(与磁盘列表同一处结论)。 -->
                <ScrollViewer x:Name="GpuStrip" Grid.Row="0"
                              behaviors:HorizontalWheelScroll.Enabled="True"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Gpus}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GpuCardRow">
                        <Button Classes="item" Classes.selected="{Binding IsSelected}"
                                Height="152" Width="220" CornerRadius="8"
                                Background="{DynamicResource VelaBgInput}"
                                Command="{Binding $parent[Window].((vm:ResourceMonitorWindowViewModel)DataContext).SelectGpuCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Spacing="6" Margin="10">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.microchip}"
                                                 Foreground="{DynamicResource VelaShellMagenta}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Label}" Classes="card-value"
                                             Foreground="{DynamicResource VelaTextPrimary}"
                                             FontSize="{DynamicResource VelaFontSize12}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding UtilText}" Classes="card-value"
                                           Foreground="{DynamicResource VelaShellMagenta}" />
                              </Grid>
                              <TextBlock Text="{Binding Name}" Classes="card-sub" />
                              <Border Classes="plot" Height="34">
                                <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100"
                                                    GridRows="0" GridColumns="0">
                                  <pc:ChartSeries Values="{Binding UtilHistory.Values}" StrokeThickness="1.2"
                                                  Stroke="{DynamicResource VelaShellMagenta}"
                                                  Fill="{DynamicResource VelaShellMagentaDim}" />
                                </pc:TimeSeriesChart>
                              </Border>
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding MemText}" Classes="cell" />
                                <TextBlock Grid.Column="1" Text="{Binding MemPercentText}" Classes="cell"
                                           Foreground="{DynamicResource VelaShellCyan}" />
                              </Grid>
                              <pc:MeterBar Height="5" Value="{Binding MemPercent}"
                                           TrackBrush="{DynamicResource VelaGaugeTrack}"
                                           FillBrush="{DynamicResource VelaShellCyan}"
                                           WarnBrush="{DynamicResource VelaWarning}"
                                           CritBrush="{DynamicResource VelaError}" />
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding TempText}" Classes="cell" />
                                <TextBlock Grid.Column="1" Text="{Binding PowerText}" Classes="cell" />
                              </Grid>
                            </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                  <Border Classes="card" Grid.Column="0">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.activity}"
                                         Foreground="{DynamicResource VelaShellMagenta}" VerticalAlignment="Center" />
                          <TextBlock Text="{loc:Localize Monitor_GpuUtil}" Classes="card-title" />
                          <TextBlock Text="{Binding SelectedGpu.Label}" Classes="card-sub" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGpu.UtilText}" Classes="card-value"
                                   Foreground="{DynamicResource VelaShellMagenta}" />
                      </Grid>
                      <Border Classes="plot">
                        <Panel>
                          <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="100"
                                              GridBrush="{DynamicResource VelaBorderPrimary}">
                            <pc:ChartSeries Values="{Binding SelectedGpu.UtilHistory.Values}"
                                            Stroke="{DynamicResource VelaShellMagenta}"
                                            Fill="{DynamicResource VelaShellMagentaDim}" />
                            <pc:ChartSeries Values="{Binding SelectedGpu.MemBandwidthHistory.Values}"
                                            Stroke="{DynamicResource VelaShellBlue}"
                                            Fill="{DynamicResource VelaShellSubtleDim}" />
                          </pc:TimeSeriesChart>
                          <TextBlock Classes="axis onplot" Text="100%" HorizontalAlignment="Left" VerticalAlignment="Top" />
                          <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                          <!-- Intel 核显没有 gpu_busy_percent:说清楚是"这块卡不提供",不是"占用为 0"。 -->
                          <TextBlock Text="{loc:Localize Monitor_MetricUnavailable}" Classes="card-sub"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !SelectedGpu.HasUtil}" />
                        </Panel>
                      </Border>
                    </DockPanel>
                  </Border>
                  <Border Classes="card" Grid.Column="2">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.layers}"
                                         Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                          <TextBlock Text="{loc:Localize Monitor_Vram}" Classes="card-title" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGpu.MemText}" Classes="card-value"
                                   Foreground="{DynamicResource VelaShellCyan}" />
                      </Grid>
                      <Border Classes="plot">
                        <Panel>
                          <pc:TimeSeriesChart Revision="{Binding Revision}"
                                              Maximum="{Binding SelectedGpu.MemTotalBytes}"
                                              GridBrush="{DynamicResource VelaBorderPrimary}">
                            <pc:ChartSeries Values="{Binding SelectedGpu.MemHistory.Values}"
                                            Stroke="{DynamicResource VelaShellCyan}"
                                            Fill="{DynamicResource VelaShellCyanDim}" />
                          </pc:TimeSeriesChart>
                          <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                      </Border>
                    </DockPanel>
                  </Border>
                </Grid>

                <Border Classes="card" Grid.Row="4">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                      <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.info}"
                                     Foreground="{DynamicResource VelaShellMagenta}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize Monitor_GpuDetails}" Classes="card-title" />
                      <TextBlock Text="{Binding SelectedGpu.Label}" Classes="card-sub" />
                    </StackPanel>
                    <!-- 与网卡详情同一种属性带:每项按自身宽度排、自动折行,不设统一列宽
                         (型号名和"96 / 400 W"差着数倍宽度)。 -->
                    <ItemsControl ItemsSource="{Binding SelectedGpu.Details}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyValueRow">
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,28,6">
                            <TextBlock Text="{Binding Key}" Classes="key" />
                            <TextBlock Text="{Binding Value}" Classes="val" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>

                <Border Classes="card" Grid.Row="6">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.list-ordered}"
                                       Foreground="{DynamicResource VelaShellMagenta}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_GpuProcesses}" Classes="card-title" />
                      </StackPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,70,70,110" Margin="0,0,14,4">
                        <TextBlock Text="{loc:Localize Monitor_ColProcess}" Classes="col" />
                        <TextBlock Grid.Column="1" Text="{loc:Localize Monitor_Gpu}" Classes="col" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="PID" Classes="col" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{loc:Localize Monitor_Vram}" Classes="col" TextAlignment="Right" />
                      </Grid>
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding GpuProcesses}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GpuProcessRow">
                              <Grid ColumnDefinitions="*,70,70,110" Height="24">
                                <TextBlock Text="{Binding Name}" Classes="cell"
                                           Foreground="{DynamicResource VelaTextPrimary}" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuText}" Classes="cell" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding Pid}" Classes="cell" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" Classes="cell" TextAlignment="Right"
                                           Foreground="{DynamicResource VelaShellCyan}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>

              <!-- ══ 内存 ══ -->
              <Grid Margin="16" IsVisible="{Binding IsMemoryPage}" RowDefinitions="262,12,Auto,12,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,12,250">
                  <Border Classes="card" Grid.Column="0">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.memory-stick}"
                                         Foreground="{DynamicResource VelaShellYellow}" VerticalAlignment="Center" />
                          <TextBlock Text="{loc:Localize Monitor_Memory}" Classes="card-title" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Classes="card-value"
                                   Foreground="{DynamicResource VelaShellYellow}" />
                      </Grid>
                      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Rectangle Classes="dot" Fill="{DynamicResource VelaShellYellow}" />
                          <TextBlock Text="{loc:Localize Monitor_Used}" Classes="legend" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Rectangle Classes="dot" Fill="{DynamicResource VelaShellSubtle}" />
                          <TextBlock Text="{loc:Localize Monitor_CacheBuffers}" Classes="legend" />
                        </StackPanel>
                      </StackPanel>
                      <Border Classes="plot">
                        <Panel>
                          <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="{Binding MemoryTotalBytes}"
                                              GridBrush="{DynamicResource VelaBorderPrimary}">
                            <pc:ChartSeries Values="{Binding CacheHistory.Values}"
                                            Stroke="{DynamicResource VelaShellSubtle}"
                                            Fill="{DynamicResource VelaShellSubtleDim}" />
                            <pc:ChartSeries Values="{Binding MemoryHistory.Values}"
                                            Stroke="{DynamicResource VelaShellYellow}"
                                            Fill="{DynamicResource VelaShellYellowDim}" />
                          </pc:TimeSeriesChart>
                          <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                      </Border>
                    </DockPanel>
                  </Border>
                  <Border Classes="card" Grid.Column="2">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Text="{loc:Localize Monitor_Details}" Classes="card-title" Margin="0,0,0,7" />
                      <!-- 交换分区自成一块,和上面的明细之间压一条分隔线:两者读数格式相同,
                           不隔开会看成明细的最后一行。 -->
                      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                        <Border Height="1" Margin="0,0,0,4" Background="{DynamicResource VelaBorderPrimary}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock Text="{loc:Localize Monitor_Swap}" Classes="key" />
                          <TextBlock Grid.Column="1" Text="{Binding SwapText}" Classes="val"
                                     TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <pc:MeterBar Height="6" Value="{Binding SwapPercent}"
                                     TrackBrush="{DynamicResource VelaGaugeTrack}"
                                     FillBrush="{DynamicResource VelaStatusConnected}"
                                     WarnBrush="{DynamicResource VelaWarning}"
                                     CritBrush="{DynamicResource VelaError}" />
                      </StackPanel>
                      <!-- 明细行等高铺满剩余高度:固定行距会在卡片下半截留出一大块空白,
                           读数挤在右上角。 -->
                      <ItemsControl ItemsSource="{Binding MemoryDetails}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:KeyValueRow">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Key}" Classes="key" />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="val"
                                         TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                  </Border>
                </Grid>

                <!-- 内存组合条:已用 / 缓存缓冲 / 空闲 按实际比例分配宽度 -->
                <Border Classes="card" Grid.Row="2">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.layers}"
                                     Foreground="{DynamicResource VelaShellYellow}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize Monitor_MemComposition}" Classes="card-title" />
                    </StackPanel>
                    <Grid Height="30" ColumnSpacing="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding MemoryUsedRatio, Converter={x:Static conv:StarLengthConverter.Instance}}" />
                        <ColumnDefinition Width="{Binding MemoryCacheRatio, Converter={x:Static conv:StarLengthConverter.Instance}}" />
                        <ColumnDefinition Width="{Binding MemoryFreeRatio, Converter={x:Static conv:StarLengthConverter.Instance}}" />
                      </Grid.ColumnDefinitions>
                      <Border Background="{DynamicResource VelaShellYellow}" CornerRadius="3" Opacity="0.8" />
                      <Border Grid.Column="1" Background="{DynamicResource VelaShellSubtle}" CornerRadius="3" Opacity="0.8" />
                      <Border Grid.Column="2" Background="{DynamicResource VelaGaugeTrack}" CornerRadius="3" />
                    </Grid>
                    <!-- 图例走固定排布而不是跟着比例分栏:空闲只剩 13% 时,那一栏窄到
                         连"空闲"两个字都放不下,文字会被裁掉半截。整排水平居中。 -->
                    <StackPanel Orientation="Horizontal" Spacing="20">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource VelaShellYellow}" Opacity="0.8" />
                        <!-- 名称与读数走同一个 TextBlock 的两个 Run:分成两个 TextBlock 时,
                             界面字体与等宽字体的行框高度不同,各自居中就把两段文字错开一像素。
                             同一段文字里的 Run 共用基线,字号再怎么调都不会错行。 -->
                        <TextBlock Classes="legend">
                          <Run Text="{loc:Localize Monitor_Used}" FontFamily="{DynamicResource VelaUiFont}"
                               Foreground="{DynamicResource VelaTextSecondary}" />
                          <Run Text=" " /><Run Text="{Binding MemoryUsedText}" Foreground="{DynamicResource VelaTextPrimary}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource VelaShellSubtle}" Opacity="0.8" />
                        <TextBlock Classes="legend">
                          <Run Text="{loc:Localize Monitor_CacheBuffers}" FontFamily="{DynamicResource VelaUiFont}"
                               Foreground="{DynamicResource VelaTextSecondary}" />
                          <Run Text=" " /><Run Text="{Binding MemoryCacheText}" Foreground="{DynamicResource VelaTextPrimary}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource VelaGaugeTrack}" />
                        <TextBlock Classes="legend">
                          <Run Text="{loc:Localize Monitor_Free}" FontFamily="{DynamicResource VelaUiFont}"
                               Foreground="{DynamicResource VelaTextSecondary}" />
                          <Run Text=" " /><Run Text="{Binding MemoryFreeText}" Foreground="{DynamicResource VelaTextPrimary}" />
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="card" Grid.Row="4">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                      <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.list-ordered}"
                                     Foreground="{DynamicResource VelaShellYellow}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize Monitor_TopByMemory}" Classes="card-title" />
                    </StackPanel>
                    <!-- 列宽两处必须一模一样:表头与行分属两棵子树,列定义写岔了肉眼很难发现。 -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,80,90,70,90,90,70" Margin="0,0,14,4">
                      <TextBlock Text="{loc:Localize Monitor_ColProcess}" Classes="col" />
                      <TextBlock Grid.Column="1" Text="PID" Classes="col" TextAlignment="Right" />
                      <TextBlock Grid.Column="2" Text="{loc:Localize Monitor_ColRss}" Classes="col" TextAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{loc:Localize Monitor_ColMemShare}" Classes="col" TextAlignment="Right" />
                      <TextBlock Grid.Column="4" Text="{loc:Localize Monitor_ColShared}" Classes="col" TextAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="{loc:Localize Monitor_ColSwap}" Classes="col" TextAlignment="Right" />
                      <TextBlock Grid.Column="6" Text="{loc:Localize Monitor_ColCpu}" Classes="col" TextAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding TopMemoryProcesses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProcessRow">
                            <Grid ColumnDefinitions="*,80,90,70,90,90,70" Height="26">
                              <TextBlock Text="{Binding Command}" Classes="cell"
                                         Foreground="{DynamicResource VelaTextPrimary}" Margin="0,0,10,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Pid}" Classes="cell" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Classes="cell" TextAlignment="Right"
                                         Foreground="{DynamicResource VelaShellYellow}" />
                              <TextBlock Grid.Column="3" Text="{Binding PercentText}" Classes="cell" TextAlignment="Right"
                                         Foreground="{DynamicResource VelaShellYellow}" />
                              <TextBlock Grid.Column="4" Text="{Binding SharedText}" Classes="cell" TextAlignment="Right" />
                              <TextBlock Grid.Column="5" Text="{Binding SwapText}" Classes="cell" TextAlignment="Right" />
                              <TextBlock Grid.Column="6" Text="{Binding CpuText}" Classes="cell" TextAlignment="Right" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>

              <!-- ══ 磁盘 ══ -->
              <!-- 上半区按"放得下 4 块盘"定高(4×90 + 卡头 + 内边距),不用星号:
                   星号在大窗口/最大化时会把这一块拉得老高,而磁盘条目本来就只有那么多。 -->
              <Grid Margin="16" IsVisible="{Binding IsDiskPage}" RowDefinitions="408,12,*">
                <Grid Grid.Row="0" ColumnDefinitions="300,12,*">
                  <Border Classes="card" Grid.Column="0">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.hard-drive}"
                                       Foreground="{DynamicResource VelaShellGreen}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_PhysicalDisks}" Classes="card-title" />
                        <TextBlock Text="{Binding DiskCountText}" Classes="card-sub" />
                      </StackPanel>
                      <!-- 滚动条留白放在内容的 Margin 上,不用 ScrollViewer.Padding:
                           后者会让 ItemsControl 按"视口宽"排布子项、按"视口宽减留白"报告自身宽度,
                           子项因此被排成比容器还宽,右侧读数被裁掉半个字。 -->
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Disks}" Margin="0,0,14,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DiskDeviceRow">
                              <!-- 卡片本体就是按钮:外面再套一层 Border 时,按钮模板的方角背景会盖住
                                   内层圆角,表现为"圆角没了"。选中态用强调色描边。 -->
                              <Button Classes="item" Classes.selected="{Binding IsSelected}"
                                      Height="82" Margin="0,0,0,8"
                                      Command="{Binding $parent[Window].((vm:ResourceMonitorWindowViewModel)DataContext).SelectDiskCommand}"
                                      CommandParameter="{Binding}">
                                  <!-- 三段各归其位:名称/型号/活动率贴顶,容量与占用率贴底,
                                       占用条撑在中间。全塞进 StackPanel 时三行会挤在卡片上半截。 -->
                                  <DockPanel Margin="10,8">
                                    <!-- 型号必须单独占一列并省略号截断:放进星号列里的横向 StackPanel
                                         不会裁剪,长型号会压过右侧的活动率读数。 -->
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                      <TextBlock Text="{Binding Name}" Classes="card-value"
                                                 FontSize="{DynamicResource VelaFontSize11}"
                                                 Foreground="{DynamicResource VelaTextPrimary}" />
                                      <TextBlock Grid.Column="1" Text="{Binding Model}" Classes="card-sub" />
                                      <TextBlock Grid.Column="2" Text="{Binding ActivityText}" Classes="cell"
                                                 Foreground="{DynamicResource VelaShellGreen}" />
                                    </Grid>
                                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                      <TextBlock Text="{Binding CapacityText}" Classes="cell" />
                                      <TextBlock Grid.Column="1" Text="{Binding UsedPercentText}" Classes="cell pct"
                                                 Classes.warn="{Binding IsWarn}" Classes.crit="{Binding IsCrit}" />
                                    </Grid>
                                    <pc:MeterBar Height="8" VerticalAlignment="Center" Value="{Binding UsedPercent}"
                                                 TrackBrush="{DynamicResource VelaGaugeTrack}"
                                                 FillBrush="{DynamicResource VelaShellGreen}"
                                                 WarnBrush="{DynamicResource VelaWarning}"
                                                 CritBrush="{DynamicResource VelaError}" />
                                  </DockPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>

                  <Border Classes="card" Grid.Column="2">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.activity}"
                                         Foreground="{DynamicResource VelaShellGreen}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding SelectedDisk.Name}" Classes="card-title" />
                          <TextBlock Text="{loc:Localize Monitor_Throughput}" Classes="card-sub" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding DiskThroughputText}" Classes="card-value"
                                   Foreground="{DynamicResource VelaShellGreen}" />
                      </Grid>
                      <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding DiskDetails}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyValueRow">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Key}" Classes="axis" Margin="0" />
                                <TextBlock Text="{Binding Value}" Classes="val" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                      <Border Classes="plot">
                        <Panel>
                          <pc:TimeSeriesChart Revision="{Binding SelectedDisk.Revision}" Maximum="0"
                                              GridBrush="{DynamicResource VelaBorderPrimary}">
                            <pc:ChartSeries Values="{Binding SelectedDisk.ReadHistory.Values}"
                                            Stroke="{DynamicResource VelaShellGreen}"
                                            Fill="{DynamicResource VelaShellGreenDim}" />
                            <pc:ChartSeries Values="{Binding SelectedDisk.WriteHistory.Values}"
                                            Stroke="{DynamicResource VelaShellMagenta}"
                                            Fill="{DynamicResource VelaShellMagentaDim}" />
                          </pc:TimeSeriesChart>
                          <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                      </Border>
                    </DockPanel>
                  </Border>
                </Grid>

                <Border Classes="card" Grid.Row="2">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                      <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.folder-tree}"
                                     Foreground="{DynamicResource VelaShellGreen}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize Monitor_Partitions}" Classes="card-title" />
                    </StackPanel>
                    <!-- 列序同设计稿:挂载点 / 设备 / 文件系统 / 占用条 / 已用总量 / 使用率。
                         表头与行的列定义必须逐字一致,写岔了读数会串列。 -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,190,90,180,150,64" Margin="0,0,14,2">
                      <TextBlock Text="{loc:Localize Monitor_ColMount}" Classes="col" />
                      <TextBlock Grid.Column="1" Text="{loc:Localize Monitor_ColDevice}" Classes="col" />
                      <TextBlock Grid.Column="2" Text="{loc:Localize Monitor_ColFsType}" Classes="col" />
                      <TextBlock Grid.Column="3" Text="{loc:Localize Monitor_ColUsage}" Classes="col" />
                      <TextBlock Grid.Column="4" Text="{loc:Localize Monitor_ColCapacity}" Classes="col"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="5" Text="%" Classes="col" TextAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="PartitionList" Margin="0,0,14,0" ItemsSource="{Binding Partitions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PartitionRow">
                            <!-- 隔行压一层浅底:挂载点这类长路径逐行扫视时,没有底纹很容易看串行。 -->
                            <Border Classes="row" Height="30" CornerRadius="4" Padding="6,0" Margin="-6,0">
                              <Grid ColumnDefinitions="*,190,90,180,150,64">
                                <TextBlock Text="{Binding MountPoint}" Classes="cell"
                                           Foreground="{DynamicResource VelaTextPrimary}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="cell" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding FsType}" Classes="cell" Margin="0,0,10,0" />
                                <pc:MeterBar Grid.Column="3" Height="8" Margin="0,0,20,0"
                                             VerticalAlignment="Center" Value="{Binding Percent}"
                                             TrackBrush="{DynamicResource VelaGaugeTrack}"
                                             FillBrush="{DynamicResource VelaShellGreen}"
                                             WarnBrush="{DynamicResource VelaWarning}"
                                             CritBrush="{DynamicResource VelaError}" />
                                <TextBlock Grid.Column="4" Text="{Binding UsedText}" Classes="cell"
                                           TextAlignment="Right" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="5" Text="{Binding PercentText}" Classes="cell pct"
                                           Classes.warn="{Binding IsWarn}" Classes.crit="{Binding IsCrit}"
                                           TextAlignment="Right" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Grid>

              <!-- ══ 网络 ══ -->
              <!-- 四条横带自上而下:卡片条 / 吞吐曲线 / 网卡详情 / 连接占用 Top。
                   详情那条是 Auto 高 —— 它只有一两排属性,给星号就会被窗口高度拉稀(改版前的老毛病)。
                   曲线与连接表按 2:1 分剩余高度,不给曲线写死高度:写死 300 时,750 高的默认窗口
                   连一行连接都放不下(截帧眼校),而最大化后曲线又不跟着长、表格底下空一大片。 -->
              <Grid Margin="16" IsVisible="{Binding IsNetworkPage}" RowDefinitions="Auto,12,2*,12,Auto,12,*">
                <!-- 横向卡片条:滚轮横滚 + 底部 16px 让给悬浮滚动条,详见 GPU 页同一处的注释。 -->
                <ScrollViewer x:Name="NicStrip" Grid.Row="0"
                              behaviors:HorizontalWheelScroll.Enabled="True"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Nics}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NicRow">
                        <Button Classes="item" Classes.selected="{Binding IsSelected}"
                                Height="132" Width="288" CornerRadius="8"
                                Background="{DynamicResource VelaBgInput}"
                                Command="{Binding $parent[Window].((vm:ResourceMonitorWindowViewModel)DataContext).SelectNicCommand}"
                                CommandParameter="{Binding}">
                            <DockPanel Margin="10">
                              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <pc:LucideIcon Width="13" Height="13" Data="{StaticResource Icon.ethernet-port}"
                                                 Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding Name}" Classes="card-value"
                                             FontSize="{DynamicResource VelaFontSize12}"
                                             Foreground="{DynamicResource VelaTextPrimary}" />
                                  <TextBlock Text="{Binding IpAddress}" Classes="axis" Margin="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                  <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                           Fill="{DynamicResource VelaStatusConnected}"
                                           IsVisible="{Binding IsUp}" />
                                  <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                           Fill="{DynamicResource VelaStatusDisconnected}"
                                           IsVisible="{Binding !IsUp}" />
                                  <TextBlock Text="{Binding StateText}" Classes="axis" Margin="0" />
                                </StackPanel>
                              </Grid>
                              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="↓" Classes="cell" Foreground="{DynamicResource VelaShellCyan}" />
                                  <TextBlock Text="{Binding RxText}" Classes="cell"
                                             Foreground="{DynamicResource VelaShellCyan}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0">
                                  <TextBlock Text="↑" Classes="cell" Foreground="{DynamicResource VelaShellMagenta}" />
                                  <TextBlock Text="{Binding TxText}" Classes="cell"
                                             Foreground="{DynamicResource VelaShellMagenta}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LinkText}" Classes="axis onplot" Margin="0"
                                           HorizontalAlignment="Right" />
                              </Grid>
                              <Border Classes="plot">
                                <pc:TimeSeriesChart Revision="{Binding Revision}" Maximum="0" Mirrored="True"
                                                    GridRows="0" GridColumns="0"
                                                    MidlineBrush="{DynamicResource VelaBorderPrimary}">
                                  <pc:ChartSeries Values="{Binding RxHistory.Values}" StrokeThickness="1.2"
                                                  Stroke="{DynamicResource VelaShellCyan}"
                                                  Fill="{DynamicResource VelaShellCyanDim}" />
                                  <pc:ChartSeries Values="{Binding TxHistory.Values}" StrokeThickness="1.2" Mirror="True"
                                                  Stroke="{DynamicResource VelaShellMagenta}"
                                                  Fill="{DynamicResource VelaShellMagentaDim}" />
                                </pc:TimeSeriesChart>
                              </Border>
                            </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Border Classes="card" Grid.Row="2">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.activity}"
                                       Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedNic.Name}" Classes="card-title" />
                        <TextBlock Text="{loc:Localize Monitor_Throughput}" Classes="card-sub" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding NetThroughputText}" Classes="card-value"
                                 Foreground="{DynamicResource VelaShellCyan}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Rectangle Classes="dot" Fill="{DynamicResource VelaShellCyan}" />
                        <TextBlock Text="{loc:Localize Monitor_Down}" Classes="legend" />
                        <TextBlock Text="{Binding SelectedNic.RxText}" Classes="legend" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Rectangle Classes="dot" Fill="{DynamicResource VelaShellMagenta}" />
                        <TextBlock Text="{loc:Localize Monitor_Up}" Classes="legend" />
                        <TextBlock Text="{Binding SelectedNic.TxText}" Classes="legend" />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="plot">
                      <Panel>
                        <pc:TimeSeriesChart Revision="{Binding SelectedNic.Revision}" Maximum="0" Mirrored="True"
                                            GridRows="8" GridColumns="8"
                                            GridBrush="{DynamicResource VelaBorderPrimary}"
                                            MidlineBrush="{DynamicResource VelaBorderSecondary}">
                          <pc:ChartSeries Values="{Binding SelectedNic.RxHistory.Values}"
                                          Stroke="{DynamicResource VelaShellCyan}"
                                          Fill="{DynamicResource VelaShellCyanDim}" />
                          <pc:ChartSeries Values="{Binding SelectedNic.TxHistory.Values}" Mirror="True"
                                          Stroke="{DynamicResource VelaShellMagenta}"
                                          Fill="{DynamicResource VelaShellMagentaDim}" />
                        </pc:TimeSeriesChart>
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Down}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Up}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <TextBlock Classes="axis onplot" Text="{loc:Localize Monitor_Now}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Panel>
                    </Border>
                  </DockPanel>
                </Border>

                <!-- 网卡详情:整行一条属性带,高度由字段数决定(Auto)。
                     改版前它是左边一张定宽卡、右边留给连接表,窗口一放大卡片就被拉高,
                     八行明细在里面上下摊开,中间全是空白 —— 用户反馈的"太稀疏"就是这个。 -->
                <Border Classes="card" Grid.Row="4">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                      <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.info}"
                                     Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                      <TextBlock Text="{loc:Localize Monitor_NicDetails}" Classes="card-title" />
                      <TextBlock Text="{Binding SelectedNic.Name}" Classes="card-sub" />
                    </StackPanel>
                    <!-- WrapPanel 不设 ItemWidth:IPv6 地址比 MTU 长四五倍,统一列宽要么把地址
                         截成省略号、要么让 MTU 后面拖一大截空白。每项按自身宽度排,靠右侧 Margin 断开,
                         窗口越宽一行装得越多,窄了自动折行。 -->
                    <ItemsControl ItemsSource="{Binding SelectedNic.Details}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyValueRow">
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,28,6">
                            <TextBlock Text="{Binding Key}" Classes="key" />
                            <TextBlock Text="{Binding Value}" Classes="val" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>

                <!-- 连接占用 Top:整行一张表(对端地址与进程名本来就吃宽度),
                     多出来的窗口高度也归它。ss -ti 的逐连接字节计数差分;拿不到给一句人话,不留空白。 -->
                <Border Classes="card" Grid.Row="6">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="7" Margin="0,0,0,8">
                        <pc:LucideIcon Width="14" Height="14" Data="{StaticResource Icon.arrow-up-down}"
                                       Foreground="{DynamicResource VelaShellCyan}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Monitor_TopConnections}" Classes="card-title" />
                      </StackPanel>
                      <!-- 对端定宽、进程占星号:改成整行后再让对端吃星号,地址与进程名之间
                           会拉开一千多像素的空档(截帧眼校)。320 够放下 IPv6 socket 地址。 -->
                      <Grid DockPanel.Dock="Top" ColumnDefinitions="320,*,110,110" Margin="0,0,14,4"
                            IsVisible="{Binding !ConnectionsUnavailable}">
                        <TextBlock Text="{loc:Localize Monitor_ColPeer}" Classes="col" />
                        <TextBlock Grid.Column="1" Text="{loc:Localize Monitor_ColProcess}" Classes="col" />
                        <TextBlock Grid.Column="2" Text="{loc:Localize Monitor_Down}" Classes="col" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{loc:Localize Monitor_Up}" Classes="col" TextAlignment="Right" />
                      </Grid>
                      <Panel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding !ConnectionsUnavailable}">
                          <ItemsControl Margin="0,0,14,0" ItemsSource="{Binding TopConnections}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ConnectionRow">
                                <Grid ColumnDefinitions="320,*,110,110" Height="26">
                                  <TextBlock Text="{Binding Peer}" Classes="cell"
                                             Foreground="{DynamicResource VelaTextPrimary}" Margin="0,0,8,0" />
                                  <TextBlock Grid.Column="1" Text="{Binding Process}" Classes="cell" Margin="0,0,8,0" />
                                  <TextBlock Grid.Column="2" Text="{Binding RxText}" Classes="cell" TextAlignment="Right"
                                             Foreground="{DynamicResource VelaShellCyan}" />
                                  <TextBlock Grid.Column="3" Text="{Binding TxText}" Classes="cell" TextAlignment="Right"
                                             Foreground="{DynamicResource VelaShellMagenta}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{loc:Localize Monitor_ConnectionsUnavailable}" Classes="card-sub"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding ConnectionsUnavailable}" />
                      </Panel>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>

            <!-- 连续采样失败提示 -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Background="{DynamicResource VelaBgSurface}"
                    BorderBrush="{DynamicResource VelaWarning}" BorderThickness="1"
                    CornerRadius="4" Padding="10,5"
                    IsVisible="{Binding IsStale}">
              <TextBlock Text="{loc:Localize Monitor_Stale}" Classes="legend"
                         Foreground="{DynamicResource VelaWarning}" />
            </Border>
          </Panel>
        </Grid>
      </Grid>
    </Border>

    <Panel x:Name="ResizeGrips" ZIndex="200">
      <Border Tag="North" Height="5" VerticalAlignment="Top" Margin="10,0" Background="Transparent" Cursor="TopSide" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="South" Height="5" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" Cursor="BottomSide" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="West" Width="5" HorizontalAlignment="Left" Margin="0,10" Background="Transparent" Cursor="LeftSide" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="East" Width="5" HorizontalAlignment="Right" Margin="0,10" Background="Transparent" Cursor="RightSide" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="NorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="NorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="SouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeEdge_PointerPressed" />
      <Border Tag="SouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeEdge_PointerPressed" />
    </Panel>
  </Panel>
</Window>

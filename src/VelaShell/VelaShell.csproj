<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\velashell.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- 语法高亮定义(AvaloniaEdit 未内置的那几种)。用 EmbeddedResource 而非 AvaloniaResource:
         HighlightingLoader 要的是普通 Stream,由 Assembly.GetManifestResourceStream 提供。
         资源名 = "VelaShell.Syntax.<文件名>",与 SyntaxHighlightingService 里的常量对应。 -->
    <EmbeddedResource Include="Syntax\*.xshd" />
  </ItemGroup>

  <!--
    Release 发布形态:自包含、摊开(**刻意不用 PublishSingleFile**)。

    2026-08-12 起从单文件改回摊开发布,起因是插件系统:隔离模式插件由主程序拉起
    VelaShell.PluginHost 进程(见 Plugins/Isolated/PluginProcessClient),单文件会把
    PluginHost 的托管程序集连同整套运行时一起打进 VelaShell.exe 的 bundle,磁盘上根本没有
    可执行体 —— 打包版里隔离插件必然拉不起宿主。要么让第二个进程各带一套运行时(包体近乎
    翻倍),要么摊开发布让两个可执行体共用同一份运行时;选后者。

    连带影响是自更新:换版原先靠"复制新版单文件到临时目录当更新器"。摊开发布后单个 exe
    离开应用目录就跑不起来,改为直接运行暂存目录里那份完整的新版应用当更新器,换版也随之
    从"移动"改为"复制"(见 Services/Update/UpdateApplier)。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Wayland" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.Avalonia" />
  </ItemGroup>

  <!-- 见 VelaShell.Terminal.csproj 同处注释:签名构建(Release)省略友元声明,非签名构建保留。 -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="VelaShell.Tests" />
  </ItemGroup>

  <!--
    关于页的依赖版本(见 Services/PackageVersions.cs):把 Directory.Packages.props 里 pin 的
    包版本在编译期写进程序集元数据,免得手写版本号跟着漂(它已经漂过一次:关于页停在 12.0.5,
    实际引用早已是 12.1.0)。

    为什么不在运行时读 .deps.json:它记的是程序集版本而非包版本,解析它还得在启动路径上多读
    一个文件、多一套 JSON 结构要维护(该文件曾因单文件发布压根不落盘,如今摊开发布才有,
    这种"随发布形态变化的依赖"本身就不该出现在关于页这种小功能上)。
    为什么不读程序集版本:那与包版本不是一回事 —— SSH.NET 程序集报 2025.1.0.1、
    ReactiveUI 报 23.0.0.0,而包版本是 2025.1.0 / 23.2.28。

    这里把 17 个包全写进去(每条几十字节),而不是只挑关于页当前用到的那两个:
    否则关于页每加一个依赖都得回来改构建脚本,这种隐式耦合迟早被漏掉。
  -->
  <Target Name="EmbedPackageVersions" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'%(PackageVersion.Version)' != ''">
        <_Parameter1>PackageVersion:%(PackageVersion.Identity)</_Parameter1>
        <_Parameter2>%(PackageVersion.Version)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VelaShell.Core\VelaShell.Core.csproj" />
    <ProjectReference Include="..\VelaShell.Terminal\VelaShell.Terminal.csproj" />
    <ProjectReference Include="..\VelaShell.Presentation\VelaShell.Presentation.csproj" />
    <ProjectReference Include="..\VelaShell.Controls\VelaShell.Controls.csproj" />
    <ProjectReference Include="..\VelaShell.Infrastructure\VelaShell.Infrastructure.csproj" />
    <!-- 隔离插件的宿主进程:随应用分发(exe/deps/runtimeconfig 一并进输出目录)。 -->
    <ProjectReference Include="..\VelaShell.PluginHost\VelaShell.PluginHost.csproj" />
  </ItemGroup>

  <!--
    ======================== 第一方插件从哪里来 ========================
    2026-08-21 之前:插件工程就在本仓库的 plugins/ 下,这里对 plugins/*/*.csproj 建一个
    纯构建顺序引用,F5 时插件自动重建并镜像进本项目 bin/ 的 plugins/。

    现在:插件随工具链搬去了 joesdu/velashell-plugin-toolchain,以 **Release 资产**
    velashell-plugins-<版本>.zip 的形式交付,包内布局就是安装包 plugins/ 那一层。
    本仓库按根 Directory.Build.props 的 VelaPluginsBundleVersion 取那一版,解到
    artifacts/plugins/ 作为暂存目录,构建与发布都从这里取件。

    暂存目录怎么来:
      · 日常:pwsh scripts/Fetch-Plugins.ps1      —— 按 pin 的版本下载并校验 sha256
      · 联调:pwsh scripts/Fetch-Plugins.ps1 -FromToolchain <工具链仓库路径>
              —— 就地构建那边的插件,不走网络
      · CI:  发布流水线在 publish 之前跑同一个脚本(见 .github/workflows/release.yml)
    也可以用 -p:VelaPluginsStageDir=<目录> 直接指别处。
  -->
  <PropertyGroup>
    <VelaPluginsStageDir Condition="'$(VelaPluginsStageDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\plugins</VelaPluginsStageDir>
  </PropertyGroup>

  <!-- 开发内环:把暂存目录镜像进本项目输出的 plugins/,F5 即可装载。
       暂存目录不存在就静默跳过 —— 没取过插件的干净克隆照样能构建、能跑,
       只是启动后一个插件都没有。发布路径不接受这种情况,见 AddVelaPluginsToPublish。 -->
  <Target Name="CopyVelaPluginsToOutput" AfterTargets="Build" Condition="Exists('$(VelaPluginsStageDir)')">
    <ItemGroup>
      <_VelaStagedPluginFile Include="$(VelaPluginsStageDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VelaStagedPluginFile)"
          DestinationFiles="@(_VelaStagedPluginFile->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    发布期把"随应用分发"的插件放进安装包的 plugins/<目录名>/ —— 运行时的插件发现根之一
    (另一个是用户手动安装目录 ~/.velashell/plugins/,见 PluginServiceCollectionExtensions)。

    为什么必须显式做这件事:publish 只收 ResolvedFileToPublish 里登记过的文件,不扫 bin
    目录 —— 不登记,发行包里就一个插件都没有(上面的 CopyVelaPluginsToOutput 只管 F5)。

    走 ResolvedFileToPublish 而不是 AfterTargets="Publish" 手工拷贝:让 -o / 增量 /
    各 RID 布局都由 SDK 统一处理。ExcludeFromSingleFile 是道保险 —— 当前发布形态已不用
    单文件(见上面 Release 的 PropertyGroup),但插件 dll 必须以磁盘上的真实文件形态存在
    (ALC 要按 deps.json 解析装载),万一哪天有人重新打开单文件,这行能挡住它们被卷进 bundle。

    哪些插件进包不再由本仓库决定 —— 分发包里有什么就装什么。那一头由工具链仓库各插件的
    <VelaPluginShip> 把关(示例插件 velashell.hello-world 设了 false,不进包)。

    **必须 AfterTargets 而非 BeforeTargets**(#181,1.2.2 全平台发行包踩过):
    ComputeResolvedFilesToPublishList 的正文里会跑 ResolveOverlappingItemGroupConflicts,
    在 _ResolvedCopyLocalPublishAssets(应用自己的 NuGet 产物)与此刻已有的 ResolvedFileToPublish
    之间消重 —— 而它只按**文件名**判冲突,完全不看 RelativePath。插件目录里凡有与应用根目录
    同名的程序集(AI 插件经 LiveMarkdown.Avalonia 传递引入了 MicroCom.Runtime.dll /
    Avalonia.Remote.Protocol.dll),版本又一样,应用根目录那份就会被判为输家删掉,
    发行包里只剩 plugins/velashell-ai/ 下的那份。后果是 Windows 上 Avalonia.Win32 启动即
    FileNotFoundException: MicroCom.Runtime —— 且只有解压全新包的用户会遇到,应用内更新
    只覆盖清单里的文件、不删多余文件,老版本留下的那份反而把问题掩盖了。
    放到冲突消重之后再登记,两份各就各位、互不相干。下面的
    VerifyVelaAppPublishAssetsIntact 是这条顺序约束的看门狗。
  -->
  <Target Name="AddVelaPluginsToPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_VelaPluginPayload Include="$(VelaPluginsStageDir)\**\*" />
    </ItemGroup>
    <!-- 暂存目录空了会悄无声息地发出一个"插件系统看着在、实则没插件"的包,
         宁可在这里断掉发布。发布路径不像构建路径那样容忍缺插件。 -->
    <Error Condition="'@(_VelaPluginPayload)' == ''"
           Text="发布产物里没有任何插件:插件暂存目录 '$(VelaPluginsStageDir)' 是空的或不存在。先跑 `pwsh scripts/Fetch-Plugins.ps1` 取回 pin 的那一版($(VelaPluginsBundleVersion)),或用 -p:VelaPluginsStageDir= 指到别处。" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_VelaPluginPayload)">
        <RelativePath>plugins\%(_VelaPluginPayload.RecursiveDir)%(_VelaPluginPayload.Filename)%(_VelaPluginPayload.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    看门狗:确保应用自身的 copy-local 产物一个都没在发布期被消重掉(#181)。

    ComputeResolvedFilesToPublishList 正文里的 ResolveOverlappingItemGroupConflicts 按文件名
    在"应用产物"与"此刻已登记的 ResolvedFileToPublish"之间挑输赢,凡是在它跑之前往
    ResolvedFileToPublish 里塞过东西的自定义 target(本项目的 AddVelaPluginsToPublish 就是,
    见上),都可能让应用根目录悄悄少掉一个 dll —— 构建全绿、包也照出,只在最终用户
    双击时炸(1.2.2 的 MicroCom.Runtime 即如此,启动直接 FileNotFoundException)。
    这里前后各取一次快照,差集非空就断掉发布,把"顺序约束"从注释变成硬约束。

    Before 的 target 在 DependsOnTargets(_ComputeResolvedCopyLocalPublishAssets)之后、
    正文之前执行,因此拿到的正是消重前的完整集合。
  -->
  <Target Name="_SnapshotVelaAppPublishAssets" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_VelaAppPublishAssetBefore Include="@(_ResolvedCopyLocalPublishAssets)" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyVelaAppPublishAssetsIntact" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_VelaAppPublishAssetDropped Include="@(_VelaAppPublishAssetBefore)"
                                   Exclude="@(_ResolvedCopyLocalPublishAssets)" />
    </ItemGroup>
    <Error Condition="'@(_VelaAppPublishAssetDropped)' != ''"
           Text="发布产物缺少应用自身的依赖(被发布期文件名冲突消重删掉了):@(_VelaAppPublishAssetDropped->'%(Filename)%(Extension)', ', ')。多半是又有 target 在 ComputeResolvedFilesToPublishList **之前**往 ResolvedFileToPublish 里登记了同名文件(见 AddVelaPluginsToPublish 的注释,#181)。" />
  </Target>
</Project>

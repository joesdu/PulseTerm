<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- 插件把 Avalonia 设成 ExcludeAssets="runtime"(运行时由宿主共享),这份排除会沿
         ProjectReference 传到这里 —— 于是测试输出目录里没有 Avalonia.Base.dll。
         而 Ui/Mvvm.cs 的 RaisePropertyChanged 引用了 Dispatcher,JIT 编译该方法就要解析它,
         不显式引一次就是运行期 FileNotFoundException(与 S3 测试项目同一条注记)。 -->
    <PackageReference Include="Avalonia" />
    <!-- 面板的 headless 装载测试:AXAML 真装载一次,样式选择器/模板/索引器绑定
         这些编译期看不出的问题才会暴露。 -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\VelaShell.Plugin.Redis\VelaShell.Plugin.Redis.csproj" />
    <ProjectReference Include="..\..\plugin-sdk\VelaShell.PluginSdk.Testing\VelaShell.PluginSdk.Testing.csproj" />
  </ItemGroup>

</Project>

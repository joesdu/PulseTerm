<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VelaShell.Presentation\VelaShell.Presentation.csproj" />
    <!-- 插件命令桥测试复用 SDK 测试替身(顺带 dogfood Testing 包)。 -->
    <!-- SDK 测试替身。同上,默认包引用、VelaSdkPath 时切本地工程。 -->
    <PackageReference Include="VelaShell.PluginSdk.Testing" Condition="'$(VelaSdkPath)' == ''" />
    <ProjectReference Include="$(VelaSdkTestingProject)" Condition="'$(VelaSdkPath)' != ''" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- 管理服务的单测用替身客户端驱动 IAmazonS3。 -->
    <PackageReference Include="NSubstitute" />
    <!-- 环回服务器要按收到的原始请求行重算 SigV4,因此测试项目自己也要引 SDK 的类型。 -->
    <PackageReference Include="AWSSDK.S3" />
    <!-- 插件把 Avalonia 设成 ExcludeAssets="runtime"(运行时由宿主共享),这份排除会沿
         ProjectReference 传到这里 —— 于是测试输出目录里没有 Avalonia.Base.dll。
         而 Ui/Mvvm.cs 的 RaisePropertyChanged 引用了 Dispatcher,JIT 编译该方法就要解析它,
         不显式引一次就是运行期 FileNotFoundException。 -->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\VelaShell.Plugin.S3\VelaShell.Plugin.S3.csproj" />
    <ProjectReference Include="..\..\plugin-sdk\VelaShell.PluginSdk.Testing\VelaShell.PluginSdk.Testing.csproj" />
  </ItemGroup>

</Project>

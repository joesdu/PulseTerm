<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>宿主插件运行时用例的通用夹具:激活写存储、注册若干命令。非示例代码。</Description>
    <RootNamespace>VelaShell.TestPlugin</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- 夹具要被当成真插件装载:生成 deps.json(ALC 依赖解析依据)、不复制共享框架。 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!--
    这份 plugin.json **刻意不进输出目录**(没有 CopyToOutputDirectory)。

    CopyToOutputDirectory 的内容项会顺着 ProjectReference 流进引用方的输出目录,而两个夹具
    都被 VelaShell.Infrastructure.Tests 引用 —— 两份 plugin.json 会落在同一个 bin 根下互相
    覆盖,谁赢取决于构建顺序。PluginTerminalProtocolEndToEndTests 读的正是那一份,于是
    "同样的代码,昨天绿今天红":它拿到通用夹具的清单(id velashell.test-fixture、
    entry VelaShell.TestPlugin.dll),协议自然注册不上。

    留在输出里的那一份必须是 VelaShell.TestPlugin.Terminal 的 —— 只有终端链路那条用例
    要读真清单(测 contributes/activationEvents 写没写对)。本夹具的用例全都自己写一份
    临时清单(每条用例要变的字段不一样),不需要输出目录里有它;这个文件留在源码树里,
    是夹具身份(id / entry)的单一出处,给人读的。
  -->
  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约由装载方(测试宿主)统一提供,不随夹具输出复制 —— 与真插件同一条规则:
         VelaShell.PluginSdk 必须与装载方是同一份程序集,复制过去就成了两份类型。 -->
    <PackageReference Include="VelaShell.PluginSdk" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
